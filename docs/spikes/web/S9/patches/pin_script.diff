diff -ruN pin_script/src/lua/config.rs b/pin_script/src/lua/config.rs
--- pin_script/src/lua/config.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/pin_script/src/lua/config.rs	2026-11-20 16:45:45.000000000 +0000
@@ -0,0 +1,36 @@
+//! [`LuaConfig`]: the Lua backend's limits. Built with or without the
+//! backend itself (pin_script feature `native-backends`), so `pin_sim`'s
+//! `SimConfig` keeps its shape on every target.
+
+/// Limits of one Lua backend (§3.4, D25).
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+pub struct LuaConfig {
+    /// Hard cap on the Lua heap, bytes.
+    pub memory_limit_bytes: usize,
+    /// VM instructions allowed per callback (granularity `HOOK_INTERVAL`).
+    pub instruction_budget: u32,
+}
+
+impl LuaConfig {
+    /// The configuration the engine runs table rules with (DECISIONS.md
+    /// "Orchestrator — 4.2 re-review round 3"): 100 000 instructions per
+    /// callback and a 2 MiB heap. Under it no script can make a single tick
+    /// take more than 8 ms (release build; measured in DECISIONS.md "4.2 — fix
+    /// round 3"). [`LuaConfig::default`] keeps the brief's larger limits for
+    /// tools and tests.
+    pub const fn engine() -> Self {
+        Self {
+            memory_limit_bytes: 2 * 1024 * 1024,
+            instruction_budget: 100_000,
+        }
+    }
+}
+
+impl Default for LuaConfig {
+    fn default() -> Self {
+        Self {
+            memory_limit_bytes: 16 * 1024 * 1024,
+            instruction_budget: 1_000_000,
+        }
+    }
+}
diff -ruN pin_script/src/lua/libm_abi.rs b/pin_script/src/lua/libm_abi.rs
--- pin_script/src/lua/libm_abi.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/pin_script/src/lua/libm_abi.rs	2026-11-20 19:21:01.000000000 +0000
@@ -0,0 +1,34 @@
+//! KHZ (web spike S2): the transcendental functions the patched Lua calls
+//! when built with `KHZ_LUA_MATH` (third_party/lua-src: `KHZ_MATHOP`), so
+//! `math.sin`, `^` and friends give the same bits on every target (the
+//! engine's Rust `libm`, D9) instead of the platform C library's.
+#![allow(unsafe_code)]
+
+macro_rules! khz1 {
+    ($($name:ident => $f:path),* $(,)?) => {$(
+        #[doc = concat!("`", stringify!($name), "` for the patched Lua (Rust libm).")]
+        #[unsafe(no_mangle)]
+        pub extern "C" fn $name(x: f64) -> f64 {
+            $f(x)
+        }
+    )*};
+}
+
+khz1! {
+    khz_sin => libm::sin, khz_cos => libm::cos, khz_tan => libm::tan,
+    khz_asin => libm::asin, khz_acos => libm::acos, khz_exp => libm::exp,
+    khz_log => libm::log, khz_log2 => libm::log2, khz_log10 => libm::log10,
+    khz_sinh => libm::sinh, khz_cosh => libm::cosh, khz_tanh => libm::tanh,
+}
+
+/// `atan2` for the patched Lua (Rust libm).
+#[unsafe(no_mangle)]
+pub extern "C" fn khz_atan2(y: f64, x: f64) -> f64 {
+    libm::atan2(y, x)
+}
+
+/// `pow` for the patched Lua (Rust libm).
+#[unsafe(no_mangle)]
+pub extern "C" fn khz_pow(x: f64, y: f64) -> f64 {
+    libm::pow(x, y)
+}
