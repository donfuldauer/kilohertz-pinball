diff -ruN pin_script/src/wasm/config.rs b/pin_script/src/wasm/config.rs
--- pin_script/src/wasm/config.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/pin_script/src/wasm/config.rs	2026-11-20 16:45:45.000000000 +0000
@@ -0,0 +1,34 @@
+//! [`WasmConfig`]: the Wasm backend's limits. Built with or without the
+//! backend itself (pin_script feature `native-backends`), so `pin_sim`'s
+//! `SimConfig` keeps its shape on every target.
+
+/// Limits of one Wasm backend (§3.4, D25).
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+pub struct WasmConfig {
+    /// Hard cap on the guest's linear memory, bytes.
+    pub memory_limit_bytes: usize,
+    /// Fuel (≈ Wasm operators) allowed per callback.
+    pub fuel_per_callback: u64,
+}
+
+impl WasmConfig {
+    /// The configuration the engine runs table rules with, matching
+    /// `LuaConfig::engine`: a 2 MiB memory cap and 100 000 fuel
+    /// per callback. [`WasmConfig::default`] keeps the larger tool/test
+    /// limits.
+    pub const fn engine() -> Self {
+        Self {
+            memory_limit_bytes: 2 * 1024 * 1024,
+            fuel_per_callback: 100_000,
+        }
+    }
+}
+
+impl Default for WasmConfig {
+    fn default() -> Self {
+        Self {
+            memory_limit_bytes: 16 * 1024 * 1024,
+            fuel_per_callback: 1_000_000,
+        }
+    }
+}
