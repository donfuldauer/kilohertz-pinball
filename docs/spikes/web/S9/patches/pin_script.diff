 [dependencies]
 pin_core.workspace = true
-mlua.workspace = true
-notify.workspace = true
+# web-spike-sim: the native backends are optional (default on) so the sim
+# crates build for wasm32 without the vendored C Lua or wasmtime.
+mlua = { workspace = true, optional = true }
+# web-spike-lua (S2): Lua's transcendental math through the engine's libm.
+libm = { workspace = true, optional = true }
+notify = { workspace = true, optional = true }
 # 4.5 fix B1: wasmtime::wasmparser (the exact version wasmtime uses) for the
 # pre-compile size scan.
-wasmtime = { workspace = true, features = ["reexport-wasmparser"] }
+wasmtime = { workspace = true, features = ["reexport-wasmparser"], optional = true }
 # 4.5 fix B1: WAT text -> binary before the size pre-scan. The exact version
 # wasmtime 50 already pulls in (Cargo.lock); Orchestrator may move the pin to
 # the root.
-wat.workspace = true
+wat = { workspace = true, optional = true }
+
+[features]
+default = ["native-backends"]
+# The Lua 5.4 (mlua + vendored C Lua) and wasmtime backends. Off: only the
+# name tables and the backend limit types are built (web builds supply their
+# own backend through pin_sim's `ExternalScript`).
+native-backends = ["lua", "dep:notify", "dep:wasmtime", "dep:wat"]
+# web-spike-lua (S2): the Lua 5.4 backend alone (mlua + vendored C Lua), without
+# hot reload (notify) or wasmtime, so it builds for wasm32-unknown-unknown.
+lua = ["dep:mlua", "dep:libm"]
+# web-spike-lua (S2) proposal: drop `collectgarbage` from the sandbox; its
+# only answer ("count", the Lua heap in KiB) depends on pointer size, so a
+# script could make native and web replays diverge with it.
+web-parity = ["lua"]
 
 [dev-dependencies]
 proptest.workspace = true
