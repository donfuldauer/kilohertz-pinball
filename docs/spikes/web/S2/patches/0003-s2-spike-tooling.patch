+//! Trap and stack probes (req. 6): shadow-stack use of the sandbox cases,
+//! stack-pointer restoration after Lua errors unwind through C and Rust
+//! frames, and the per-case instance health check.
+
+use crate::sandbox::{CASES, run_case};
+use pin_core::{HostCommandQueue, HostCtx, HostView, Pcg32, SeedableRng, TableScriptBackend};
+use pin_script::NameTables;
+use pin_script::lua::{LuaConfig, LuaScriptBackend};
+use s1_harness::probes::approx_sp;
+use std::fmt::Write as _;
+
+/// Runs `n` faulting callbacks of each kind (runtime error through a Rust
+/// API function, budget, memory, error caught by pcall in Lua) and reports
+/// the approximate stack pointer before and after: a Lua error is a
+/// `longjmp` (a Wasm exception on the web) through C and Rust frames, which
+/// must leave the shadow stack pointer where it was.
+#[must_use]
+pub fn sp_after_errors(n: u32) -> String {
+    let before = approx_sp();
+    let srcs = [
+        "function on_tick() local ok = pcall(pinball.pulse_coil, 'x', 1) pinball.pulse_coil('x', 1) end",
+        "function on_tick() while true do end end",
+        "function on_tick() local t={} for i=1,1000 do t[i]=string.rep('a',60000)..i end end",
+        "function on_tick() for i=1,50 do pcall(error, 'e') end error('x') end",
+    ];
+    let mut faults = 0;
+    let view = HostView::default();
+    let mut rng = Pcg32::seed_from_u64(1);
+    for _ in 0..n {
+        for s in srcs {
+            let mut b = LuaScriptBackend::new(s.as_bytes(), &NameTables::default(), LuaConfig::engine())
+                .expect("load");
+            let mut cmd = HostCommandQueue::default();
+            b.on_tick(&mut HostCtx { view: &view, rng: &mut rng, cmd: &mut cmd });
+            faults += b.fault_count();
+        }
+    }
+    // One backend, many pcall'd errors inside a single callback.
+    let mut b = LuaScriptBackend::new(
+        b"function on_tick() for i=1,2000 do pcall(error, i) end end",
+        &NameTables::default(),
+        LuaConfig::default(),
+    )
+    .expect("load");
+    for _ in 0..n {
+        let mut cmd = HostCommandQueue::default();
+        b.on_tick(&mut HostCtx { view: &view, rng: &mut rng, cmd: &mut cmd });
+    }
+    let after = approx_sp();
+    format!(
+        "sp_before={before:#x} sp_after={after:#x} delta={} faults={faults} pcall_errors={}",
+        before as i64 - after as i64,
+        u64::from(n) * 2000
+    )
+}
+
+/// Shadow-stack bytes each sandbox case uses below the caller (wasm only).
+#[must_use]
+pub fn case_stack() -> String {
+    let mut s = String::new();
+    for c in CASES {
+        #[cfg(target_arch = "wasm32")]
+        {
+            let ((line, _), used, painted) =
+                s1_harness::probes::stack_highwater(900 * 1024, || run_case(c));
+            let _ = writeln!(s, "{} stack_used={used} painted={painted} ok={}", c.name, !line.is_empty());
+        }
+        #[cfg(not(target_arch = "wasm32"))]
+        {
+            let (line, _) = run_case(c);
+            let _ = writeln!(s, "{} stack_used=n/a ok={}", c.name, !line.is_empty());
+        }
+    }
+    s
+}
