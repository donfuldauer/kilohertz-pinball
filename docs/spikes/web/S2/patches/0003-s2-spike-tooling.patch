+
+fn class(e: &ScriptError) -> String {
+    match e {
+        ScriptError::BudgetExceeded => "B".into(),
+        ScriptError::MemoryLimit => "M".into(),
+        ScriptError::Runtime(m) => format!("R:{:016x}", fnv(m.as_bytes())),
+        ScriptError::Load(m) => format!("L:{:016x}", fnv(m.as_bytes())),
+        other => format!("X:{other:?}"),
+    }
+}
+
+fn fnv(b: &[u8]) -> u64 {
+    let mut h = Fnv64::new();
+    for &x in b {
+        h.write_u8(x);
+    }
+    h.finish()
+}
+
+fn msg(e: &ScriptError) -> String {
+    match e {
+        ScriptError::Runtime(m) | ScriptError::Load(m) => m.clone(),
+        other => format!("{other:?}"),
+    }
+}
+
+/// Runs one case; returns its line and, separately, the platform-dependent
+/// heap size.
+#[must_use]
+pub fn run_case(c: &Case) -> (String, usize) {
+    let cfg = LuaConfig::engine();
+    let names = NameTables::default();
+    let mut out = format!("{} |", c.name);
+    let mut b = match LuaScriptBackend::new(c.src.as_bytes(), &names, cfg) {
+        Ok(b) => b,
+        Err(e) => {
+            let _ = write!(out, " new={} | first_msg={:?}", class(&e), msg(&e));
+            return (out, 0);
+        }
+    };
+    let mut view = HostView::default();
+    let mut rng = Pcg32::seed_from_u64(0x5eed_0002);
+    let mut digest = Fnv64::new();
+    let mut scratch = Vec::with_capacity(4096);
+    let mut events = String::new();
+    let mut first_msg: Option<String> = None;
+    let mut last_faults = 0;
+    let mut run_one = |b: &mut LuaScriptBackend,
+                       view: &HostView,
+                       rng: &mut Pcg32,
+                       f: &mut dyn FnMut(&mut LuaScriptBackend, &mut HostCtx)|
+     -> String {
+        let mut cmd = HostCommandQueue::default();
+        f(b, &mut HostCtx {
+            view,
+            rng,
+            cmd: &mut cmd,
+        });
+        scratch.clear();
+        encode_queue(&cmd, &mut scratch);
+        for &x in &scratch {
+            digest.write_u8(x);
+        }
+        let ev = if b.fault_count() != last_faults {
+            last_faults = b.fault_count();
+            let e = b.last_error().cloned().unwrap_or(ScriptError::Runtime("?".into()));
+            if first_msg.is_none() {
+                first_msg = Some(msg(&e));
+            }
+            class(&e)
+        } else if b.is_faulted() {
+            "f".into()
+        } else {
+            "ok".into()
+        };
+        ev + ","
+    };
+    for step in c.plan {
+        match *step {
+            Init => events.push_str(&run_one(&mut b, &view, &mut rng, &mut |b, ctx| b.on_init(ctx))),
+            Tick(n) => {
+                for _ in 0..n {
+                    view.tick += 1;
+                    events.push_str(&run_one(&mut b, &view, &mut rng, &mut |b, ctx| b.on_tick(ctx)));
+                }
+            }
+            Sw(id, closed) => {
+                let edge = if closed {
+                    SwitchEdge::Closed
+                } else {
+                    SwitchEdge::Opened
+                };
+                events.push_str(&run_one(&mut b, &view, &mut rng, &mut |b, ctx| {
+                    b.on_switch_edge(SwitchId(id), edge, ctx);
+                }));
+            }
+            Reload(src) => {
+                let r = b.apply_reload(src.as_bytes());
+                let _ = write!(
+                    events,
+                    "reload:{},",
+                    r.as_ref().map_or_else(class, |()| "ok".into())
+                );
+            }
+        }
+    }
+    // Compress long runs of identical events ("ok,ok,ok" -> "ok*3").
+    let mut ev = String::new();
+    let parts: Vec<&str> = events.trim_end_matches(',').split(',').collect();
+    let mut i = 0;
+    while i < parts.len() {
+        let mut j = i;
+        while j < parts.len() && parts[j] == parts[i] {
+            j += 1;
+        }
+        let _ = write!(
+            ev,
+            "{}{}{}",
+            if ev.is_empty() { "" } else { "," },
+            parts[i],
+            if j - i > 1 { format!("*{}", j - i) } else { String::new() }
+        );
+        i = j;
+    }
+    let _ = write!(
+        out,
+        " events={ev} | cmd={:016x} | faults={} faulted={} rng={:016x} | first_msg={:?}",
+        digest.finish(),
+        b.fault_count(),
+        b.is_faulted(),
+        rng_state(&rng),
+        first_msg.unwrap_or_default()
+    );
+    (out, b.used_memory())
+}
+
+fn rng_state(r: &Pcg32) -> u64 {
+    let mut r = r.clone();
+    pin_core::Rng::next_u64(&mut r)
+}
+
+/// Runs every case (or those whose name contains `filter`); one line per case
+/// with ` | mem=<bytes>` appended.
+#[must_use]
+pub fn run_all(filter: &str) -> String {
+    let mut s = String::new();
+    for c in CASES.iter().filter(|c| c.name.contains(filter)) {
+        let (line, mem) = run_case(c);
+        let _ = writeln!(s, "{line} | mem={mem}");
+    }
+    s
+}
+
+/// Case names and descriptions (`name\twhat` lines).
+#[must_use]
+pub fn describe() -> String {
+    let mut s = String::new();
+    for c in CASES {
+        let _ = writeln!(s, "{}\t{}", c.name, c.what);
+    }
+    s
+}
+
+/// Budget-edge probe: for each operation, the largest iteration count `n`
+/// whose callback still fits the engine budget (binary search). Equal
+/// numbers native and wasm mean the budget charges the same; a difference
+/// shows a platform-dependent charge.
+#[must_use]
+pub fn budget_edge() -> String {
+    const OPS: &[(&str, &str)] = &[
+        ("concat_700", "local s=string.rep('x',700) local t={s} for i=1,N do local r=table.concat(t) end"),
+        ("format_700", "local s=string.rep('x',700) for i=1,N do local r=string.format('%s', s) end"),
+        ("format_400", "local s=string.rep('x',400) for i=1,N do local r=string.format('%s', s) end"),
+        ("gsub_600", "local s=string.rep('ab',300) for i=1,N do local r=string.gsub(s, 'a', 'c') end"),
+        ("rep_900", "for i=1,N do local r=string.rep('y', 900) end"),
+        ("concat_op", "local a=string.rep('q',300) for i=1,N do local r=a..a..a end"),
+        ("arith", "local x=0 for i=1,N do x=x+i*2 end"),
+        ("tables", "for i=1,N do local t={i,i,i} end"),
+    ];
+    let mut s = String::new();
+    for (name, body) in OPS {
+        let fits = |n: u32| {
+            let src = format!("function on_tick() local N={n} {body} end");
+            let mut b = match LuaScriptBackend::new(src.as_bytes(), &NameTables::default(), LuaConfig::engine()) {
+                Ok(b) => b,
+                Err(_) => return false,
+            };
+            let view = HostView::default();
+            let mut rng = Pcg32::seed_from_u64(1);
+            let mut cmd = HostCommandQueue::default();
+            b.on_tick(&mut HostCtx { view: &view, rng: &mut rng, cmd: &mut cmd });
+            !b.is_faulted()
+        };
+        let (mut lo, mut hi) = (0u32, 1u32);
+        while fits(hi) && hi < 1 << 24 {
+            lo = hi;
+            hi *= 2;
+        }
+        while hi - lo > 1 {
+            let mid = lo + (hi - lo) / 2;
+            if fits(mid) {
+                lo = mid;
+            } else {
+                hi = mid;
+            }
+        }
+        let _ = writeln!(s, "{name} n_max={lo}");
+    }
+    s
+}
