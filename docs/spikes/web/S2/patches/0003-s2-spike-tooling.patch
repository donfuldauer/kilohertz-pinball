+//! Route (f): the Lua rules in their own wasm instance.
+//!
+//! Protocol (all little-endian, in the module's static buffer [`l_buf`]):
+//! * `l_new(src_len, names_len)`: buffer = rules.lua bytes then the name
+//!   tables (see [`wire::decode_names`]); returns 0 or an error class.
+//! * `l_call(kind, switch, closed)`: buffer in = `HostView` (553 bytes),
+//!   RNG state (16), queue length u32 + encoded `HostCommandQueue`;
+//!   out = RNG state (16), queue length u32 + queue, faulted u8,
+//!   fault count u32. Returns the output length.
+
+pub mod wire;
+
+use pin_core::ids::SwitchId;
+use pin_core::{HostCommandQueue, HostCtx, SwitchEdge, TableScriptBackend};
+use pin_script::lua::{LuaConfig, LuaScriptBackend};
+use std::cell::RefCell;
+
+const BUF_LEN: usize = 1 << 18;
+
+thread_local! {
+    static STATE: RefCell<(Vec<u8>, Option<LuaScriptBackend>, HostCommandQueue)> =
+        RefCell::new((vec![0; BUF_LEN], None, HostCommandQueue::default()));
+}
+
+/// The shared I/O buffer.
+#[unsafe(no_mangle)]
+pub extern "C" fn l_buf() -> *mut u8 {
+    STATE.with(|s| s.borrow_mut().0.as_mut_ptr())
+}
+
+/// Loads a script: 0 ok, 1 load error, 2 budget, 3 memory, 4 other.
+#[unsafe(no_mangle)]
+pub extern "C" fn l_new(src_len: u32, names_len: u32) -> u32 {
+    STATE.with(|s| {
+        let mut s = s.borrow_mut();
+        let (buf, slot, _) = &mut *s;
+        let src = buf[..src_len as usize].to_vec();
+        let names = wire::decode_names(&buf[src_len as usize..(src_len + names_len) as usize]);
+        match LuaScriptBackend::new(&src, &names, LuaConfig::engine()) {
+            Ok(b) => {
+                *slot = Some(b);
+                0
+            }
+            Err(e) => wire::err_class(&e),
+        }
+    })
+}
+
+/// Runs one callback (0 init, 1 tick, 2 switch edge); returns the output
+/// length in the buffer.
+#[unsafe(no_mangle)]
+pub extern "C" fn l_call(kind: u32, switch: u32, closed: u32) -> u32 {
+    STATE.with(|s| {
+        let mut s = s.borrow_mut();
+        let (buf, slot, q) = &mut *s;
+        let Some(b) = slot.as_mut() else { return 0 };
+        let (view, mut rng) = wire::read_input(buf, q);
+        {
+            let mut ctx = HostCtx { view: &view, rng: &mut rng, cmd: q };
+            match kind {
+                0 => b.on_init(&mut ctx),
+                1 => b.on_tick(&mut ctx),
+                _ => {
+                    let edge = if closed != 0 { SwitchEdge::Closed } else { SwitchEdge::Opened };
+                    b.on_switch_edge(SwitchId(switch as u16), edge, &mut ctx);
+                }
+            }
+        }
+        wire::write_output(buf, &rng, q, b.is_faulted(), b.fault_count()) as u32
+    })
+}
