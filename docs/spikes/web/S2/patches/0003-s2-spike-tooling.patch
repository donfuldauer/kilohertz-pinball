+//! Number formatting, parsing and libm parity probes. These run in a plain
+//! mlua state over the same patched Lua library (base, string, table, math,
+//! utf8; `string.pack` kept so results can be printed as exact bits), so
+//! they test the C library underneath Lua: glibc natively, wasi-libc (musl)
+//! on wasm. Inputs come from a fixed PCG seed, identical on every target.
+
+use mlua::{Lua, LuaOptions, StdLib, Table};
+use pin_core::{Pcg32, Rng, SeedableRng};
+use std::fmt::Write as _;
+
+fn lua() -> Lua {
+    let libs = StdLib::STRING | StdLib::TABLE | StdLib::MATH | StdLib::UTF8;
+    Lua::new_with(libs, LuaOptions::new()).expect("lua state")
+}
+
+/// `n` doubles: random bit patterns (every exponent, subnormals, inf/NaN),
+/// random short decimals, integers, halves and a fixed edge list.
+#[must_use]
+pub fn sample_floats(n: usize, seed: u64) -> Vec<f64> {
+    let mut v = vec![
+        0.0,
+        -0.0,
+        0.1,
+        0.5,
+        1.5,
+        2.5,
+        1e23,
+        5e-324,
+        2.225_073_858_507_201e-308,
+        2.225_073_858_507_201_4e-308,
+        f64::MAX,
+        f64::MIN_POSITIVE,
+        f64::EPSILON,
+        1e15,
+        1e16,
+        123_456_789_012_345.67,
+        9_007_199_254_740_993.0,
+        0.30000000000000004,
+        f64::INFINITY,
+        f64::NEG_INFINITY,
+        1.0 / 3.0,
+        2.0f64.powi(63),
+        -2.0f64.powi(63),
+        4.35,
+        0.125,
+        1e-5,
+        1e-4,
+        123_456.5,
+        0.000_123_45,
+    ];
+    let mut r = Pcg32::seed_from_u64(seed);
+    while v.len() < n {
+        let x = match r.next_u32() % 7 {
+            6 => {
+                // Subnormal (exponent field 0), either sign.
+                let b = (r.next_u64() & 0x000f_ffff_ffff_ffff) | (u64::from(r.next_u32() & 1) << 63);
+                f64::from_bits(b)
+            }
+            0 | 1 => f64::from_bits(r.next_u64()),
+            2 => {
+                let m = f64::from(r.next_u32() % 2_000_000) - 1_000_000.0;
+                let e = r.next_u32() % 12;
+                m / 10f64.powi(e as i32)
+            }
+            3 => (r.next_u64() >> (r.next_u32() % 64)) as f64 * if r.next_u32() & 1 == 0 { 1.0 } else { -1.0 },
+            4 => f64::from(r.next_u32() % 100_000) + 0.5,
+            _ => {
+                let m = f64::from_bits((r.next_u64() & 0x000f_ffff_ffff_ffff) | 0x3ff0_0000_0000_0000);
+                m * 2f64.powi((r.next_u32() % 200) as i32 - 100)
+            }
+        };
+        if !x.is_nan() {
+            v.push(x);
+        }
+    }
+    v
+}
+
+const FORMAT_SCRIPT: &str = r#"
+local xs = ...
+local out = {}
+local fmts = {'%.14g','%.17g','%a','%.3a','%.0a','%A','%e','%.3e','%.0e','%f','%.3f','%.0f','%g','%.3g','%.0g','%#g','%10.4f','%-24.10e','%+.5g','% .2e','%.20g','%.40e','%.60f'}
+for i = 1, #xs do
+  local x = xs[i]
+  local parts = { tostring(x) }
+  for _, f in ipairs(fmts) do parts[#parts + 1] = string.format(f, x) end
+  if math.type(x) == 'float' and x == x then parts[#parts + 1] = string.format('%q', x) end
+  local back = tonumber(tostring(x))
+  parts[#parts + 1] = back and string.format('%016x', string.unpack('<i8', string.pack('<d', back))) or 'nil'
+  local s17 = string.format('%.17g', x)
+  local b17 = tonumber(s17)
+  parts[#parts + 1] = b17 and string.format('%016x', string.unpack('<i8', string.pack('<d', b17))) or 'nil'
+  out[#out + 1] = table.concat(parts, ' ')
+end
+return out
+"#;
+
+/// Formats `n` sample floats with tostring and 23 `string.format`
+/// conversions, plus `%q`, and parses `tostring` / `%.17g` back with
+/// `tonumber`. Returns the text (one line per float).
+#[must_use]
+pub fn format_dump(n: usize) -> String {
+    let lua = lua();
+    let xs = sample_floats(n, 0x5eed_f10a);
+    let t: Table = lua.create_sequence_from(xs).expect("table");
+    lua.load(FORMAT_SCRIPT)
+        .call::<Vec<String>>(t)
+        .map_or_else(|e| format!("ERROR {e}"), |v| v.join("\n"))
+}
+
+/// Random numeric strings: decimal (up to 200 characters, the patch 11 cap),
+/// hexadecimal floats, exponent extremes and near-halfway mantissas.
+#[must_use]
+pub fn sample_strings(n: usize, seed: u64) -> Vec<String> {
+    let mut v: Vec<String> = [
+        "0x1p-1074", "0x1p-1075", "0x1.8p-1074", "2.2250738585072011e-308", "2.2250738585072012e-308",
+        "9007199254740993", "9007199254740992.5", "9007199254740993.0000000001", "1e400", "-1e400",
+        "1e-400", "4.9406564584124654e-324", "2.4703282292062327e-324", "2.4703282292062328e-324",
+        "0x1.fffffffffffff8p1023", "0x1.fffffffffffff7p1023", "1.7976931348623158e308",
+        "1.7976931348623157e308", "0x.8p1", ".5", "5.", "0x10", "0xA.8p0", "  42  ", "1e", "0x", "0x1p",
+        "1e+", "+.e1", "0.1e-0", "1E5", "0X1P4", "00000000000000000000000000001", "-0", "-0x0p0",
+        "123456789012345678901234567890", "0.000000000000000000000000000000000001",
+    ]
+    .iter()
+    .map(|s| (*s).to_string())
+    .collect();
+    let mut r = Pcg32::seed_from_u64(seed);
+    while v.len() < n {
+        let mut s = String::new();
+        match r.next_u32() % 5 {
+            0 | 1 => {
+                if r.next_u32() % 4 == 0 {
+                    s.push('-');
+                }
+                let digits = 1 + r.next_u32() % 40;
+                for i in 0..digits {
+                    s.push(char::from(b'0' + (r.next_u32() % 10) as u8));
+                    if i == r.next_u32() % 20 {
+                        s.push('.');
+                    }
+                }
+                if r.next_u32() % 2 == 0 {
+                    let _ = write!(s, "e{}", (r.next_u32() % 700) as i32 - 350);
+                }
+            }
+            2 => {
+                // Near halfway between two doubles: 17-19 significant digits.
+                let x = f64::from_bits(r.next_u64() & 0x7fef_ffff_ffff_ffff);
+                let y = f64::from_bits(x.to_bits() + 1);
+                let _ = write!(s, "{:.25e}", (x / 2.0) + (y / 2.0));
+            }
+            3 => {
+                let _ = write!(s, "0x{:x}.{:x}p{}", r.next_u32() % 0x1f, r.next_u64(), (r.next_u32() % 2200) as i32 - 1100);
+            }
+            _ => {
+                // Long decimal (up to 200 bytes).
+                let len = 50 + r.next_u32() % 150;
+                s.push_str("0.");
+                for _ in 0..len {
+                    s.push(char::from(b'0' + (r.next_u32() % 10) as u8));
+                }
+            }
+        }
+        if s.len() <= 200 {
+            v.push(s);
+        }
+    }
+    v
+}
+
+const PARSE_SCRIPT: &str = r#"
+local ss = ...
+local out = {}
+for i = 1, #ss do
+  local x = tonumber(ss[i])
+  if x == nil then out[#out + 1] = 'nil'
+  elseif math.type(x) == 'integer' then out[#out + 1] = 'i' .. string.format('%d', x)
+  else out[#out + 1] = string.format('%016x', string.unpack('<i8', string.pack('<d', x))) end
+end
+return out
+"#;
+
+/// Parses `n` sample strings with `tonumber`; one line per string (exact
+/// bits, an integer, or nil).
+#[must_use]
+pub fn parse_dump(n: usize) -> String {
+    let lua = lua();
+    let ss = sample_strings(n, 0x5eed_57d0);
+    let t: Table = lua.create_sequence_from(ss).expect("table");
+    lua.load(PARSE_SCRIPT)
+        .call::<Vec<String>>(t)
+        .map_or_else(|e| format!("ERROR {e}"), |v| v.join("\n"))
+}
+
+const LIBM_SCRIPT: &str = r#"
+local name, xs, ys = ...
+local m = math
+local f = ({
+  sin = m.sin, cos = m.cos, tan = m.tan, asin = m.asin, acos = m.acos,
+  atan = function(x) return m.atan(x) end, atan2 = function(x, y) return m.atan(x, y) end,
+  exp = m.exp, log = function(x) return m.log(x) end, log2 = function(x) return m.log(x, 2) end,
+  log10 = function(x) return m.log(x, 10) end, logb = function(x, y) return m.log(x, y) end,
+  pow = function(x, y) return x ^ y end, sqrt = m.sqrt, fmod = m.fmod,
+  floor = function(x) return m.floor(x) end, cosh = m.cosh, sinh = m.sinh, tanh = m.tanh,
+  frexp = function(x) local a, b = m.frexp(x) return a * 2.0 ^ 0 + b end,
+  ldexp = function(x, y) return m.ldexp(x, m.floor(y) % 2100 - 1050) end,
+  fmodint = function(x, y) return x % y end,
+})[name]
+local out = {}
+for i = 1, #xs do
+  local r = f(xs[i], ys[i])
+  out[#out + 1] = string.format('%016x', string.unpack('<i8', string.pack('<d', r + 0.0)))
+end
+return out
+"#;
+
+/// Libm functions probed, with their input generator.
+pub const LIBM_FUNCS: &[&str] = &[
+    "sin", "cos", "tan", "asin", "acos", "atan", "atan2", "exp", "log", "log2", "log10", "logb",
+    "pow", "sqrt", "fmod", "floor", "cosh", "sinh", "tanh", "frexp", "ldexp", "fmodint",
+];
+
+fn libm_inputs(name: &str, n: usize) -> (Vec<f64>, Vec<f64>) {
+    let mut r = Pcg32::seed_from_u64(0x5eed_11b0 ^ name.len() as u64 ^ (u64::from(name.as_bytes()[0]) << 8));
+    let mut uni = |lo: f64, hi: f64| lo + (hi - lo) * ((r.next_u64() >> 11) as f64 / (1u64 << 53) as f64);
+    let mut xs = Vec::with_capacity(n);
+    let mut ys = Vec::with_capacity(n);
+    for i in 0..n {
+        let (x, y) = match name {
+            "asin" | "acos" => (uni(-1.0, 1.0), 0.0),
+            "exp" => (uni(-700.0, 700.0), 0.0),
+            "log" | "log2" | "log10" | "sqrt" => {
+                if i % 2 == 0 { (uni(0.0, 10.0), 0.0) } else { (uni(0.0, 1e300), 0.0) }
+            }
+            "logb" => (uni(0.0, 1e6), uni(0.01, 100.0)),
+            "pow" => (uni(0.0, 100.0), uni(-30.0, 30.0)),
+            "cosh" | "sinh" | "tanh" => (uni(-700.0, 700.0), 0.0),
+            "atan2" => (uni(-1e3, 1e3), uni(-1e3, 1e3)),
+            "fmod" | "fmodint" => (uni(-1e6, 1e6), uni(-1e3, 1e3)),
+            "ldexp" => (uni(-1e3, 1e3), uni(0.0, 4200.0)),
+            _ => {
+                if i % 3 == 0 { (uni(-10.0, 10.0), 0.0) } else if i % 3 == 1 { (uni(-1e6, 1e6), 0.0) } else { (uni(-1e18, 1e18), 0.0) }
+            }
+        };
+        xs.push(x);
+        ys.push(y);
+    }
+    (xs, ys)
+}
+
+/// Results of math function `name` over `n` inputs, as exact bits (one line
+/// per input).
+#[must_use]
+pub fn libm_dump(name: &str, n: usize) -> String {
+    let lua = lua();
+    let (xs, ys) = libm_inputs(name, n);
+    let tx: Table = lua.create_sequence_from(xs).expect("table");
+    let ty: Table = lua.create_sequence_from(ys).expect("table");
+    lua.load(LIBM_SCRIPT)
+        .call::<Vec<String>>((name, tx, ty))
+        .map_or_else(|e| format!("ERROR {e}"), |v| v.join("\n"))
+}
+
+/// The same inputs through the Rust `libm` crate (the engine's D9 libm),
+/// for the "one implementation everywhere" comparison.
+#[must_use]
+pub fn rust_libm_dump(name: &str, n: usize) -> String {
+    let (xs, ys) = libm_inputs(name, n);
+    let mut s = String::with_capacity(n * 17);
+    for (x, y) in xs.into_iter().zip(ys) {
+        let r = match name {
+            "sin" => libm::sin(x),
+            "cos" => libm::cos(x),
+            "tan" => libm::tan(x),
+            "asin" => libm::asin(x),
+            "acos" => libm::acos(x),
+            "atan" => libm::atan(x),
+            "atan2" => libm::atan2(x, y),
+            "exp" => libm::exp(x),
+            "log" => libm::log(x),
+            "log2" => libm::log2(x),
+            "log10" => libm::log10(x),
+            "pow" => libm::pow(x, y),
+            "sqrt" => libm::sqrt(x),
+            "fmod" => libm::fmod(x, y),
+            "cosh" => libm::cosh(x),
+            "sinh" => libm::sinh(x),
+            "tanh" => libm::tanh(x),
+            _ => f64::NAN,
+        };
+        let _ = writeln!(s, "{:016x}", r.to_bits());
+    }
+    s
+}
+
+/// Each of the 256 bytes through the pattern classes and case functions
+/// (C-locale `<ctype.h>` parity).
+#[must_use]
+pub fn ctype_dump() -> String {
+    let lua = lua();
+    lua.load(
+        r#"
+local out = {}
+for b = 0, 255 do
+  local c = string.char(b)
+  local bits = {}
+  for _, cl in ipairs({'%a','%c','%d','%g','%l','%p','%s','%u','%w','%x'}) do
+    bits[#bits + 1] = c:find(cl) and '1' or '0'
+  end
+  out[#out + 1] = b .. ' ' .. table.concat(bits) .. ' ' .. string.byte(c:upper()) .. ' ' .. string.byte(c:lower())
+end
+return out
+"#,
+    )
+    .call::<Vec<String>>(())
+    .map_or_else(|e| format!("ERROR {e}"), |v| v.join("\n"))
+}
