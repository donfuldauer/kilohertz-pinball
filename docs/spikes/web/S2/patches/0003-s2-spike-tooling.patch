+//! A first end-to-end check: the real `LuaScriptBackend` runs a script.
+
+use pin_core::{HostCommandQueue, HostCtx, HostView, Pcg32, SeedableRng, TableScriptBackend};
+use pin_script::NameTables;
+use pin_script::lua::{LuaConfig, LuaScriptBackend};
+
+/// Runs `src` for `ticks` ticks; returns a summary line.
+#[must_use]
+pub fn smoke(src: &str, ticks: u32) -> String {
+    let mut b = match LuaScriptBackend::new(src.as_bytes(), &NameTables::default(), LuaConfig::engine()) {
+        Ok(b) => b,
+        Err(e) => return format!("load error: {e:?}"),
+    };
+    let view = HostView::default();
+    let mut rng = Pcg32::seed_from_u64(1);
+    let mut pulses = 0usize;
+    for _ in 0..ticks {
+        let mut cmd = HostCommandQueue::default();
+        b.on_tick(&mut HostCtx { view: &view, rng: &mut rng, cmd: &mut cmd });
+        pulses += cmd.coil_pulses.len();
+    }
+    format!(
+        "faulted={} faults={} last_error={:?} pulses={} mem={}",
+        b.is_faulted(),
+        b.fault_count(),
+        b.last_error(),
+        pulses,
+        b.used_memory()
+    )
+}
