+//! Adversarial sandbox cases, run through the engine's own
+//! `LuaScriptBackend` with the engine limits (`LuaConfig::engine()`:
+//! 100 000 instructions per callback, 2 MiB heap). Each case prints one line:
+//! the outcome of every callback (ok / R:<message digest> / B / M / load
+//! error), a digest of every command queue, the fault count and the first
+//! error message. Native and wasm lines must be identical apart from the
+//! trailing `mem=` field (Lua heap bytes are pointer-size dependent).
+
+use pin_core::ids::SwitchId;
+use pin_core::{
+    HostCommandQueue, HostCtx, HostView, Pcg32, ScriptError, SeedableRng, SwitchEdge,
+    TableScriptBackend,
+};
+use pin_script::NameTables;
+use pin_script::lua::{LuaConfig, LuaScriptBackend};
+use pin_sim::hash::Fnv64;
+use s1_harness::io::encode_queue;
+use std::fmt::Write as _;
+
+/// One plan step.
+#[derive(Clone, Copy)]
+pub enum Step {
+    /// `on_init`.
+    Init,
+    /// `n` × `on_tick`.
+    Tick(u32),
+    /// A switch edge.
+    Sw(u16, bool),
+    /// `apply_reload(source)`.
+    Reload(&'static str),
+}
+
+/// A case: name, source, plan.
+pub struct Case {
+    /// Case name.
+    pub name: &'static str,
+    /// What it checks (printed in the table).
+    pub what: &'static str,
+    /// Lua source.
+    pub src: &'static str,
+    /// Callbacks to run.
+    pub plan: &'static [Step],
+}
