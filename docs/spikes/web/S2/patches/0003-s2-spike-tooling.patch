+//! Command-stream parity: the real Lua rules run inside the sim (the engine's
+//! own `LuaScriptBackend`, built with the arguments `pin_sim`'s loader uses),
+//! and every script step is compared with S1's native-recorded script-output
+//! stream (`.scr`): tick, RNG draws, digest of the switch edges and
+//! `HostView` the script saw, and the encoded command queue. Per-tick state
+//! hashes are compared with S1's native hash file. Optional per-callback
+//! timing with a caller-supplied clock.
+
+use pin_core::ids::SwitchId;
+use pin_core::{HostCtx, Pcg32, Rng, ScriptError, SwitchEdge, TableScriptBackend};
+use pin_script::lua::LuaScriptBackend;
+use pin_sim::hash::Fnv64;
+use pin_sim::{ExternalScript, SimConfig, Simulation};
+use s1_harness::driver::Driver;
+use s1_harness::hashes::ext_hash;
+use s1_harness::io::{Reader, Scenario, check_script_stream, digest_view, encode_queue};
+use s1_harness::run::{Stats, open_bundle};
+use std::fmt::Write as _;
+use std::sync::{Arc, Mutex};
+
+/// Largest number of `next_u32` draws one script step may make.
+const MAX_DRAWS: u32 = 1 << 24;
+
+fn count_draws(pre: &Pcg32, post: &Pcg32) -> Option<u32> {
+    let mut r = pre.clone();
+    for n in 0..MAX_DRAWS {
+        if r == *post {
+            return Some(n);
+        }
+        let _ = r.next_u32();
+    }
+    None
+}
+
+/// What the checker found (shared with the driver).
+#[derive(Debug, Default)]
+pub struct Check {
+    /// Steps compared.
+    pub steps: u64,
+    /// Steps whose tick differed.
+    pub tick_mismatch: u64,
+    /// Steps whose RNG draw count differed.
+    pub draw_mismatch: u64,
+    /// Steps whose input digest differed.
+    pub digest_mismatch: u64,
+    /// Steps whose command-queue bytes differed.
+    pub queue_mismatch: u64,
+    /// First tick with any mismatch.
+    pub first_mismatch: Option<u64>,
+    /// Steps after the recorded stream ended.
+    pub exhausted: u64,
+    /// Command bytes compared.
+    pub queue_bytes: u64,
+    /// Per-callback durations (ns): on_init, on_tick, on_switch.
+    pub t_init: Vec<f64>,
+    /// on_tick durations (ns).
+    pub t_tick: Vec<f64>,
+    /// on_switch_edge durations (ns).
+    pub t_switch: Vec<f64>,
+}
+
+/// What the checker needs from the backend it wraps.
+pub trait Introspect: TableScriptBackend {
+    /// Commands dropped (queue full).
+    fn overflow(&self) -> u32;
+    /// In the tilt state.
+    fn faulted(&self) -> bool;
+    /// Faults so far.
+    fn faults(&self) -> u32;
+    /// Last error.
+    fn error(&self) -> Option<&ScriptError>;
+}
+
+impl Introspect for LuaScriptBackend {
+    fn overflow(&self) -> u32 {
+        self.overflow_count()
+    }
+    fn faulted(&self) -> bool {
+        self.is_faulted()
+    }
+    fn faults(&self) -> u32 {
+        self.fault_count()
+    }
+    fn error(&self) -> Option<&ScriptError> {
+        self.last_error()
+    }
+}
+
+/// A rules backend plus the stream checker.
+pub struct CheckingScript<B: Introspect = LuaScriptBackend> {
+    inner: Box<B>,
+    scr: Vec<u8>,
+    pos: usize,
+    end: usize,
+    left: u64,
+    pre: Option<Pcg32>,
+    digest: Fnv64,
+    fresh: bool,
+    scratch: Vec<u8>,
+    clock: Option<fn() -> f64>,
+    check: Arc<Mutex<Check>>,
+}
+
+impl<B: Introspect> CheckingScript<B> {
+    fn begin(&mut self, ctx: &HostCtx) {
+        if self.fresh {
+            self.pre = Some(ctx.rng.clone());
+            self.digest = Fnv64::new();
+            self.fresh = false;
+        }
+    }
+
+    fn end(&mut self, ctx: &HostCtx) {
+        digest_view(&mut self.digest, ctx.view);
+        let pre = self.pre.take().expect("begin ran");
+        let draws = count_draws(&pre, ctx.rng).unwrap_or(u32::MAX);
+        let digest = self.digest.finish();
+        self.scratch.clear();
+        if !ctx.cmd.is_empty() {
+            encode_queue(ctx.cmd, &mut self.scratch);
+        }
+        self.fresh = true;
+        let mut c = self.check.lock().expect("check lock");
+        if self.left == 0 {
+            c.exhausted += 1;
+            return;
+        }
+        let mut r = Reader::new(&self.scr[..self.end], self.pos);
+        let rec = (|| {
+            let tick = r.u64()?;
+            let draws = r.u32()?;
+            let digest = r.u64()?;
+            let len = r.u32()? as usize;
+            let q = r.pos();
+            Some((tick, draws, digest, q, len))
+        })();
+        let Some((rtick, rdraws, rdigest, q, len)) = rec else {
+            c.exhausted += 1;
+            self.left = 0;
+            return;
+        };
+        self.pos = q + len;
+        self.left -= 1;
+        c.steps += 1;
+        c.queue_bytes += len as u64;
+        let tick = ctx.view.tick;
+        let mut bad = false;
+        if rtick != tick {
+            c.tick_mismatch += 1;
+            bad = true;
+        }
+        if rdraws != draws {
+            c.draw_mismatch += 1;
+            bad = true;
+        }
+        if rdigest != digest {
+            c.digest_mismatch += 1;
+            bad = true;
+        }
+        if self.scr.get(q..q + len) != Some(&self.scratch[..]) {
+            c.queue_mismatch += 1;
+            bad = true;
+        }
+        if bad && c.first_mismatch.is_none() {
+            c.first_mismatch = Some(tick);
+        }
+    }
+
+    fn timed<R>(&mut self, which: u8, f: impl FnOnce(&mut B) -> R) -> R {
+        match self.clock {
+            None => f(&mut self.inner),
+            Some(now) => {
+                let t0 = now();
+                let r = f(&mut self.inner);
+                let dt = now() - t0;
+                let mut c = self.check.lock().expect("check lock");
+                match which {
+                    0 => c.t_init.push(dt),
+                    1 => c.t_tick.push(dt),
+                    _ => c.t_switch.push(dt),
+                }
+                r
+            }
+        }
+    }
+}
+
+impl<B: Introspect> TableScriptBackend for CheckingScript<B> {
+    fn on_init(&mut self, ctx: &mut HostCtx) {
+        self.begin(ctx);
+        self.timed(0, |b| b.on_init(ctx));
+        self.end(ctx);
+    }
+
+    fn on_tick(&mut self, ctx: &mut HostCtx) {
+        self.begin(ctx);
+        self.timed(1, |b| b.on_tick(ctx));
+        self.end(ctx);
+    }
+
+    fn on_switch_edge(&mut self, switch: SwitchId, edge: SwitchEdge, ctx: &mut HostCtx) {
+        self.begin(ctx);
+        self.digest.write_u32(u32::from(switch.0));
+        self.digest.write_u8(u8::from(edge == SwitchEdge::Closed));
+        self.timed(2, |b| b.on_switch_edge(switch, edge, ctx));
+    }
+
+    fn apply_reload(&mut self, source: &[u8]) -> Result<(), ScriptError> {
+        self.inner.apply_reload(source)
+    }
+}
+
+impl<B: Introspect> ExternalScript for CheckingScript<B> {
+    fn overflow_count(&self) -> u32 {
+        self.inner.overflow()
+    }
+    fn is_faulted(&self) -> bool {
+        self.inner.faulted()
+    }
+    fn fault_count(&self) -> u32 {
+        self.inner.faults()
+    }
+    fn last_error(&self) -> Option<&ScriptError> {
+        self.inner.error()
+    }
+    fn alloc_exempt(&self) -> bool {
+        true
+    }
+}
+
+/// Result of [`lua_play`].
+#[derive(Debug, Default)]
+pub struct LuaPlay {
+    /// Ticks run.
+    pub ticks: u64,
+    /// Hash lines compared with the native file.
+    pub hash_lines: u64,
+    /// First tick whose `state_hash`/`ext_hash` line differed.
+    pub first_hash_mismatch: Option<u64>,
+    /// Hash lines that differed.
+    pub hash_mismatches: u64,
+    /// Final state hash.
+    pub final_state: u64,
+    /// Final supplementary hash.
+    pub final_ext: u64,
+    /// Script faults during the run.
+    pub faults: u32,
+    /// Lua heap bytes at the end (platform-specific).
+    pub lua_mem: usize,
+    /// Wall time of the whole run (ns, caller's clock; 0 without one).
+    pub wall_ns: f64,
+}
+
+/// Plays scenario `scn` on `bundle_zip` with the real Lua rules, checking
+/// every script step against `scr` and every tick's hash line against
+/// `native_hashes` (`tick state ext` lines; empty: no hash check).
+///
+/// # Errors
+/// Load and scenario failures.
+pub fn lua_play(
+    bundle_zip: &[u8],
+    scn_bytes: &[u8],
+    scr: Vec<u8>,
+    native_hashes: &[u8],
+    clock: Option<fn() -> f64>,
+) -> Result<(LuaPlay, Check), String> {
+    lua_play_with(bundle_zip, scn_bytes, scr, native_hashes, clock, "", None)
+}
+
+/// [`lua_play`] with `inject` appended to the table's `rules.lua` (fault
+/// injection; empty: none) and, with `dump`, every hash line appended to it.
+///
+/// # Errors
+/// Load and scenario failures.
+pub fn lua_play_with(
+    bundle_zip: &[u8],
+    scn_bytes: &[u8],
+    scr: Vec<u8>,
+    native_hashes: &[u8],
+    clock: Option<fn() -> f64>,
+    inject: &str,
+    dump: Option<&mut Vec<u8>>,
+) -> Result<(LuaPlay, Check), String> {
+    let lua = SimConfig::default().lua;
+    play_generic(bundle_zip, scn_bytes, scr, native_hashes, clock, dump, &mut |src, names| {
+        let mut source = src.to_vec();
+        if !inject.is_empty() {
+            source.push(b'\n');
+            source.extend_from_slice(inject.as_bytes());
+        }
+        LuaScriptBackend::new(&source, names, lua)
+    })
+}
+
+/// [`lua_play_with`] over any backend built by `make`.
+///
+/// # Errors
+/// Load and scenario failures.
+pub fn play_generic<B: Introspect + 'static>(
+    bundle_zip: &[u8],
+    scn_bytes: &[u8],
+    scr: Vec<u8>,
+    native_hashes: &[u8],
+    clock: Option<fn() -> f64>,
+    mut dump: Option<&mut Vec<u8>>,
+    make: &mut dyn FnMut(&[u8], &pin_script::NameTables) -> Result<B, ScriptError>,
+) -> Result<(LuaPlay, Check), String> {
+    let scn = Scenario::from_bytes(scn_bytes)?;
+    let (steps, pos, end) = check_script_stream(&scr)?;
+    let vfs = open_bundle(bundle_zip)?;
+    let check = Arc::new(Mutex::new(Check::default()));
+    if clock.is_some() {
+        let mut c = check.lock().expect("check lock");
+        c.t_tick.reserve(scn.ticks as usize + 1);
+        c.t_switch.reserve(1 << 16);
+    }
+    let cfg = SimConfig {
+        seed: scn.seed,
+        ..SimConfig::default()
+    };
+    let mut scr = Some(scr);
+    let c2 = Arc::clone(&check);
+    let mut sim = Simulation::load_from_vfs_with_script(&vfs, cfg, &mut |entry, src, names| {
+        if !entry.ends_with(".lua") {
+            return Err(ScriptError::UnsupportedBackend(entry.to_owned()));
+        }
+        Ok(Box::new(CheckingScript {
+            inner: Box::new(make(src, names)?),
+            scr: scr.take().expect("factory called once"),
+            pos,
+            end,
+            left: steps,
+            pre: None,
+            digest: Fnv64::new(),
+            fresh: true,
+            scratch: Vec::with_capacity(1 << 16),
+            clock,
+            check: Arc::clone(&c2),
+        }) as Box<dyn ExternalScript>)
+    })
+    .map_err(|e| e.to_string())?;
+    if sim.table_hash() != scn.table_hash {
+        return Err(format!(
+            "table hash {:016x} is not the scenario's {:016x}",
+            sim.table_hash(),
+            scn.table_hash
+        ));
+    }
+    let mut expect = native_hashes.split(|&b| b == b'\n').filter(|l| !l.is_empty());
+    let mut out = LuaPlay::default();
+    let mut line = String::with_capacity(48);
+    let mut cmp_line = |sim: &Simulation, out: &mut LuaPlay| {
+        if native_hashes.is_empty() && dump.is_none() {
+            return;
+        }
+        line.clear();
+        let _ = write!(
+            line,
+            "{} {:016x} {:016x}",
+            sim.tick(),
+            sim.state_hash(),
+            ext_hash(sim)
+        );
+        if let Some(d) = dump.as_deref_mut() {
+            d.extend_from_slice(line.as_bytes());
+            d.push(b'\n');
+        }
+        if native_hashes.is_empty() {
+            return;
+        }
+        out.hash_lines += 1;
+        if expect.next() != Some(line.as_bytes()) {
+            out.hash_mismatches += 1;
+            if out.first_hash_mismatch.is_none() {
+                out.first_hash_mismatch = Some(sim.tick());
+            }
+        }
+    };
+    cmp_line(&sim, &mut out);
+    let mut drv = Driver::new(&scn);
+    let t0 = clock.map_or(0.0, |c| c());
+    while sim.tick() < scn.ticks {
+        drv.advance(&mut sim)?;
+        cmp_line(&sim, &mut out);
+    }
+    out.wall_ns = clock.map_or(0.0, |c| c() - t0);
+    out.ticks = sim.tick();
+    out.final_state = sim.state_hash();
+    out.final_ext = ext_hash(&sim);
+    out.faults = sim.script_fault_count();
+    drop(sim);
+    let c = std::mem::take(&mut *check.lock().expect("check lock"));
+    Ok((out, c))
+}
+
+fn stats_json(v: &mut [f64]) -> String {
+    let s = Stats::of(v);
+    format!(
+        "{{\"n\":{},\"mean_us\":{:.3},\"p50_us\":{:.3},\"p99_us\":{:.3},\"p999_us\":{:.3},\"max_us\":{:.3}}}",
+        s.n,
+        s.mean / 1e3,
+        s.p50 / 1e3,
+        s.p99 / 1e3,
+        s.p999 / 1e3,
+        s.max / 1e3
+    )
+}
+
+/// One summary line (and, with timing, a JSON object of per-callback stats).
+#[must_use]
+pub fn summary(p: &LuaPlay, c: &mut Check) -> String {
+    let opt = |o: Option<u64>| o.map_or_else(|| "none".to_owned(), |t| t.to_string());
+    let mut s = format!(
+        "ticks={} steps={} tick_mm={} draw_mm={} digest_mm={} queue_mm={} first_step_mm={} exhausted={} queue_bytes={} hash_lines={} hash_mm={} first_hash_mm={} state_hash={:016x} ext_hash={:016x} faults={} lua_mem={}",
+        p.ticks,
+        c.steps,
+        c.tick_mismatch,
+        c.draw_mismatch,
+        c.digest_mismatch,
+        c.queue_mismatch,
+        opt(c.first_mismatch),
+        c.exhausted,
+        c.queue_bytes,
+        p.hash_lines,
+        p.hash_mismatches,
+        opt(p.first_hash_mismatch),
+        p.final_state,
+        p.final_ext,
+        p.faults,
+        p.lua_mem
+    );
+    if !c.t_tick.is_empty() {
+        let _ = write!(
+            s,
+            "\nTIMING {{\"wall_ms\":{:.1},\"on_init\":{},\"on_tick\":{},\"on_switch\":{}}}",
+            p.wall_ns / 1e6,
+            stats_json(&mut c.t_init),
+            stats_json(&mut c.t_tick),
+            stats_json(&mut c.t_switch)
+        );
+    }
+    s
+}
