+//! Byte encodings shared by the engine side (s2_harness `remote`) and the
+//! Lua module.
+
+use pin_core::ids::{
+    CoilId, DispenserId, DiverterId, FlipperId, LampId, MagnetId, PersistKey, ProfileId, SceneId,
+    SoundId,
+};
+use pin_core::script::MAX_PERSIST;
+use pin_core::{HostCommandQueue, HostView, Pcg32, ScriptError};
+use pin_script::NameTables;
+
+/// Bytes of an encoded `HostView`.
+pub const VIEW_BYTES: usize = 8 + 32 + 1 + 8 * MAX_PERSIST;
+
+/// The RNG state as two words (same compiler and target on both sides).
+#[must_use]
+pub fn rng_words(r: &Pcg32) -> [u64; 2] {
+    // SAFETY: Pcg32 is two u64 fields (rand_pcg 0.10.2 Lcg64Xsh32); size
+    // checked by transmute; both modules come from the same rustc/target.
+    unsafe { std::mem::transmute::<Pcg32, [u64; 2]>(r.clone()) }
+}
+
+/// The RNG from [`rng_words`].
+#[must_use]
+pub fn rng_from(w: [u64; 2]) -> Pcg32 {
+    // SAFETY: inverse of `rng_words`.
+    unsafe { std::mem::transmute::<[u64; 2], Pcg32>(w) }
+}
+
+fn u64_at(b: &[u8], o: usize) -> u64 {
+    u64::from_le_bytes(b[o..o + 8].try_into().expect("8 bytes"))
+}
+
+/// Writes the callback input; returns its length.
+pub fn write_input(buf: &mut [u8], v: &HostView, rng: &Pcg32, q: &HostCommandQueue, scratch: &mut Vec<u8>) -> usize {
+    let mut o = 0;
+    buf[o..o + 8].copy_from_slice(&v.tick.to_le_bytes());
+    o += 8;
+    for w in v.switches {
+        buf[o..o + 8].copy_from_slice(&w.to_le_bytes());
+        o += 8;
+    }
+    buf[o] = v.balls_in_play;
+    o += 1;
+    for p in v.persist {
+        buf[o..o + 8].copy_from_slice(&p.to_le_bytes());
+        o += 8;
+    }
+    for w in rng_words(rng) {
+        buf[o..o + 8].copy_from_slice(&w.to_le_bytes());
+        o += 8;
+    }
+    scratch.clear();
+    encode_queue(q, scratch);
+    buf[o..o + 4].copy_from_slice(&(scratch.len() as u32).to_le_bytes());
+    o += 4;
+    buf[o..o + scratch.len()].copy_from_slice(scratch);
+    o + scratch.len()
+}
+
+/// Reads the callback input (queue decoded into `q`).
+pub fn read_input(buf: &[u8], q: &mut HostCommandQueue) -> (HostView, Pcg32) {
+    let mut v = HostView { tick: u64_at(buf, 0), ..HostView::default() };
+    for i in 0..4 {
+        v.switches[i] = u64_at(buf, 8 + 8 * i);
+    }
+    v.balls_in_play = buf[40];
+    for i in 0..MAX_PERSIST {
+        v.persist[i] = u64_at(buf, 41 + 8 * i) as i64;
+    }
+    let o = VIEW_BYTES;
+    let rng = rng_from([u64_at(buf, o), u64_at(buf, o + 8)]);
+    let len = u32::from_le_bytes(buf[o + 16..o + 20].try_into().expect("4")) as usize;
+    let mut r = Reader { b: &buf[o + 20..o + 20 + len], pos: 0 };
+    decode_queue(&mut r, q);
+    (v, rng)
+}
+
+/// Writes the callback output; returns its length.
+pub fn write_output(buf: &mut [u8], rng: &Pcg32, q: &HostCommandQueue, faulted: bool, faults: u32) -> usize {
+    let mut scratch = Vec::with_capacity(4096);
+    encode_queue(q, &mut scratch);
+    let mut o = 0;
+    for w in rng_words(rng) {
+        buf[o..o + 8].copy_from_slice(&w.to_le_bytes());
+        o += 8;
+    }
+    buf[o..o + 4].copy_from_slice(&(scratch.len() as u32).to_le_bytes());
+    o += 4;
+    buf[o..o + scratch.len()].copy_from_slice(&scratch);
+    o += scratch.len();
+    buf[o] = u8::from(faulted);
+    buf[o + 1..o + 5].copy_from_slice(&faults.to_le_bytes());
+    o + 5
+}
+
+/// Reads the callback output: new RNG, queue (into `q`), faulted, faults.
+pub fn read_output(buf: &[u8], q: &mut HostCommandQueue) -> (Pcg32, bool, u32) {
+    let rng = rng_from([u64_at(buf, 0), u64_at(buf, 8)]);
+    let len = u32::from_le_bytes(buf[16..20].try_into().expect("4")) as usize;
+    let mut r = Reader { b: &buf[20..20 + len], pos: 0 };
+    decode_queue(&mut r, q);
+    let o = 20 + len;
+    (rng, buf[o] != 0, u32::from_le_bytes(buf[o + 1..o + 5].try_into().expect("4")))
+}
+
+/// Error class of a load failure.
+#[must_use]
+pub fn err_class(e: &ScriptError) -> u32 {
+    match e {
+        ScriptError::Load(_) => 1,
+        ScriptError::BudgetExceeded => 2,
+        ScriptError::MemoryLimit => 3,
+        _ => 4,
+    }
+}
+
+/// Encodes name tables: per list, count u16 then (len u16, bytes, id u16).
+#[must_use]
+pub fn encode_names(n: &NameTables) -> Vec<u8> {
+    let mut out = Vec::new();
+    fn list<I: Copy>(out: &mut Vec<u8>, v: &[(String, I)], id: impl Fn(I) -> u16) {
+        out.extend_from_slice(&(v.len() as u16).to_le_bytes());
+        for (name, i) in v {
+            out.extend_from_slice(&(name.len() as u16).to_le_bytes());
+            out.extend_from_slice(name.as_bytes());
+            out.extend_from_slice(&id(*i).to_le_bytes());
+        }
+    }
+    list(&mut out, &n.switches, |i| i.0);
+    list(&mut out, &n.coils, |i| i.0);
+    list(&mut out, &n.lamps, |i| i.0);
+    list(&mut out, &n.magnets, |i| i.0);
+    list(&mut out, &n.diverters, |i| i.0);
+    list(&mut out, &n.flippers, |i| i.0);
+    list(&mut out, &n.dispensers, |i| i.0);
+    list(&mut out, &n.profiles, |i| i.0);
+    list(&mut out, &n.sounds, |i| i.0);
+    list(&mut out, &n.scenes, |i| i.0);
+    list(&mut out, &n.persist, |i| i.0);
+    out
+}
+
+/// Inverse of [`encode_names`].
+#[must_use]
+pub fn decode_names(b: &[u8]) -> NameTables {
+    let mut r = Reader { b, pos: 0 };
+    fn list<I>(r: &mut Reader<'_>, mk: impl Fn(u16) -> I) -> Vec<(String, I)> {
+        let n = r.u16().unwrap_or(0);
+        (0..n)
+            .filter_map(|_| {
+                let len = usize::from(r.u16()?);
+                let s = String::from_utf8(r.take(len)?.to_vec()).ok()?;
+                Some((s, mk(r.u16()?)))
+            })
+            .collect()
+    }
+    NameTables {
+        switches: list(&mut r, pin_core::ids::SwitchId),
+        coils: list(&mut r, CoilId),
+        lamps: list(&mut r, LampId),
+        magnets: list(&mut r, MagnetId),
+        diverters: list(&mut r, DiverterId),
+        flippers: list(&mut r, FlipperId),
+        dispensers: list(&mut r, DispenserId),
+        profiles: list(&mut r, ProfileId),
+        sounds: list(&mut r, SoundId),
+        scenes: list(&mut r, SceneId),
+        persist: list(&mut r, PersistKey),
+    }
+}
+
+struct Reader<'a> {
+    b: &'a [u8],
+    pos: usize,
+}
+
+impl<'a> Reader<'a> {
+    fn take(&mut self, n: usize) -> Option<&'a [u8]> {
+        let s = self.b.get(self.pos..self.pos + n)?;
+        self.pos += n;
+        Some(s)
+    }
+    fn u8(&mut self) -> Option<u8> {
+        self.take(1).map(|s| s[0])
+    }
+    fn u16(&mut self) -> Option<u16> {
+        self.take(2).map(|s| u16::from_le_bytes([s[0], s[1]]))
+    }
+    fn u32(&mut self) -> Option<u32> {
+        self.take(4).map(|s| u32::from_le_bytes(s.try_into().expect("4")))
+    }
+    fn u64(&mut self) -> Option<u64> {
+        self.take(8).map(|s| u64::from_le_bytes(s.try_into().expect("8")))
+    }
+    fn f32(&mut self) -> Option<f32> {
+        self.u32().map(f32::from_bits)
+    }
+}
+
+/// The S1 queue encoding (`s1_harness::io::encode_queue`), copied so the
+/// module needs no wasm-bindgen crate.
+pub fn encode_queue(q: &HostCommandQueue, out: &mut Vec<u8>) {
+    fn n(out: &mut Vec<u8>, len: usize) {
+        out.extend_from_slice(&(len as u16).to_le_bytes());
+    }
+    fn u16v(out: &mut Vec<u8>, v: u16) {
+        out.extend_from_slice(&v.to_le_bytes());
+    }
+    fn f(out: &mut Vec<u8>, v: f32) {
+        out.extend_from_slice(&v.to_bits().to_le_bytes());
+    }
+    n(out, q.coil_pulses.len());
+    for &(c, ms) in &q.coil_pulses { u16v(out, c.0); u16v(out, ms); }
+    n(out, q.coil_holds.len());
+    for &(c, on) in &q.coil_holds { u16v(out, c.0); out.push(u8::from(on)); }
+    n(out, q.magnets.len());
+    for &(m, p) in &q.magnets { u16v(out, m.0); f(out, p); }
+    n(out, q.zippers.len());
+    for &(z, on) in &q.zippers { u16v(out, z.0); out.push(u8::from(on)); }
+    n(out, q.diverters.len());
+    for &(d, on) in &q.diverters { u16v(out, d.0); out.push(u8::from(on)); }
+    n(out, q.ball_spawns.len());
+    for &(d, p) in &q.ball_spawns { u16v(out, d.0); u16v(out, p.0); }
+    n(out, q.lamps.len());
+    for &(l, i) in &q.lamps { u16v(out, l.0); f(out, i); }
+    match q.gi_tint {
+        Some(t) => { out.push(1); for v in t { f(out, v); } }
+        None => out.push(0),
+    }
+    n(out, q.scores.len());
+    for &(p, s) in &q.scores { out.push(p); out.extend_from_slice(&s.to_le_bytes()); }
+    n(out, q.display_scenes.len());
+    for s in &q.display_scenes { u16v(out, s.0); }
+    n(out, q.sounds.len());
+    for &(s, g) in &q.sounds { u16v(out, s.0); f(out, g); }
+    n(out, q.persist_writes.len());
+    for &(k, v) in &q.persist_writes { u16v(out, k.0); out.extend_from_slice(&v.to_le_bytes()); }
+}
+
+fn decode_queue(r: &mut Reader<'_>, q: &mut HostCommandQueue) -> Option<()> {
+    q.clear();
+    for _ in 0..r.u16()? { q.pulse_coil(CoilId(r.u16()?), r.u16()?).ok()?; }
+    for _ in 0..r.u16()? { q.hold_coil(CoilId(r.u16()?), r.u8()? != 0).ok()?; }
+    for _ in 0..r.u16()? { q.set_magnet(MagnetId(r.u16()?), r.f32()?).ok()?; }
+    for _ in 0..r.u16()? { q.set_zipper(FlipperId(r.u16()?), r.u8()? != 0).ok()?; }
+    for _ in 0..r.u16()? { q.set_diverter(DiverterId(r.u16()?), r.u8()? != 0).ok()?; }
+    for _ in 0..r.u16()? { q.spawn_ball(DispenserId(r.u16()?), ProfileId(r.u16()?)).ok()?; }
+    for _ in 0..r.u16()? { q.set_lamp(LampId(r.u16()?), r.f32()?).ok()?; }
+    if r.u8()? == 1 { q.set_gi_tint([r.f32()?, r.f32()?, r.f32()?, r.f32()?]); }
+    for _ in 0..r.u16()? { let p = r.u8()?; q.set_score(p, r.u64()? as i64).ok()?; }
+    for _ in 0..r.u16()? { q.show_scene(SceneId(r.u16()?)).ok()?; }
+    for _ in 0..r.u16()? { q.play_sound(SoundId(r.u16()?), r.f32()?).ok()?; }
+    for _ in 0..r.u16()? { let k = PersistKey(r.u16()?); q.write_persist(k, r.u64()? as i64).ok()?; }
+    Some(())
+}
