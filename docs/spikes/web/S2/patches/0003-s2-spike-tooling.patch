+//! Native S2 driver (same entry points as the wasm-bindgen exports).
+use std::time::Instant;
+
+fn rd(p: &str) -> Vec<u8> {
+    std::fs::read(p).unwrap_or_else(|e| panic!("{p}: {e}"))
+}
+
+static START: std::sync::OnceLock<Instant> = std::sync::OnceLock::new();
+
+fn now_ns() -> f64 {
+    START.get_or_init(Instant::now).elapsed().as_nanos() as f64
+}
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let arg = |i: usize| a.get(i).cloned().unwrap_or_default();
+    let num = |i: usize, d: u32| a.get(i).and_then(|s| s.parse().ok()).unwrap_or(d);
+    match arg(1).as_str() {
+        "smoke" => println!("{}", s2_harness::smoke::smoke(&arg(2), num(3, 1))),
+        "play" | "play-timed" => {
+            let hashes = if arg(5).is_empty() || arg(5) == "-" { Vec::new() } else { rd(&arg(5)) };
+            let clock = (arg(1) == "play-timed").then_some(now_ns as fn() -> f64);
+            match s2_harness::parity::lua_play(&rd(&arg(2)), &rd(&arg(3)), rd(&arg(4)), &hashes, clock) {
+                Ok((p, mut c)) => println!("{}", s2_harness::parity::summary(&p, &mut c)),
+                Err(e) => {
+                    println!("ERROR {e}");
+                    std::process::exit(1);
+                }
+            }
+        }
+        "play-inject" => {
+            // play-inject <bundle> <scn> <scr> <inject.lua> <out_hashes>
+            let inject = String::from_utf8(rd(&arg(5))).expect("utf8");
+            let mut dump = Vec::new();
+            match s2_harness::parity::lua_play_with(&rd(&arg(2)), &rd(&arg(3)), rd(&arg(4)), &[], None, &inject, Some(&mut dump)) {
+                Ok((p, mut c)) => {
+                    std::fs::write(arg(6), &dump).expect("write hashes");
+                    println!("{}", s2_harness::parity::summary(&p, &mut c));
+                }
+                Err(e) => {
+                    println!("ERROR {e}");
+                    std::process::exit(1);
+                }
+            }
+        }
+        "sandbox" => print!("{}", s2_harness::sandbox::run_all(&arg(2))),
+        "budget-edge" => print!("{}", s2_harness::sandbox::budget_edge()),
+        "sandbox-describe" => print!("{}", s2_harness::sandbox::describe()),
+        "format" => println!("{}", s2_harness::floats::format_dump(num(2, 10_000) as usize)),
+        "parse" => println!("{}", s2_harness::floats::parse_dump(num(2, 10_000) as usize)),
+        "libm" => println!("{}", s2_harness::floats::libm_dump(&arg(2), num(3, 100_000) as usize)),
+        "rust-libm" => print!("{}", s2_harness::floats::rust_libm_dump(&arg(2), num(3, 100_000) as usize)),
+        "parse-samples" => {
+            for x in s2_harness::floats::sample_strings(num(2, 10_000) as usize, 0x5eed_57d0) {
+                println!("{x}");
+            }
+        }
+        "ctype" => println!("{}", s2_harness::floats::ctype_dump()),
+        "sp-after-errors" => println!("{}", s2_harness::probes::sp_after_errors(num(2, 100))),
+        "case-stack" => print!("{}", s2_harness::probes::case_stack()),
+        _ => eprintln!("usage: s2 smoke|play|play-timed|sandbox|sandbox-describe|format|parse|libm|rust-libm|ctype|sp-after-errors|case-stack ..."),
+    }
+}
