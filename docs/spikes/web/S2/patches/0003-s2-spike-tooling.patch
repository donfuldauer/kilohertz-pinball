+//! Route (f), engine side: a rules backend whose Lua VM lives in a separate
+//! wasm instance (`s2_lua_module`). Per callback the `HostView`, the RNG
+//! state and the current command queue are written to a buffer, JS copies it
+//! into the Lua instance, calls `l_call`, and copies the result back.
+
+use crate::parity::Introspect;
+use pin_core::ids::SwitchId;
+use pin_core::{HostCtx, ScriptError, SwitchEdge, TableScriptBackend};
+use pin_script::NameTables;
+use s2_lua_module::wire;
+use wasm_bindgen::prelude::*;
+
+#[wasm_bindgen]
+extern "C" {
+    #[wasm_bindgen(js_namespace = globalThis, js_name = s2_remote_new)]
+    fn remote_new(ptr: *const u8, src_len: u32, names_len: u32) -> u32;
+    #[wasm_bindgen(js_namespace = globalThis, js_name = s2_remote_call)]
+    fn remote_call(kind: u32, switch: u32, closed: u32, ptr: *mut u8, len: u32) -> u32;
+}
+
+/// See the module docs.
+pub struct RemoteLua {
+    buf: Vec<u8>,
+    scratch: Vec<u8>,
+    faulted: bool,
+    faults: u32,
+    err: Option<ScriptError>,
+}
+
+// SAFETY-free: plain data; the JS side is single-threaded.
+impl RemoteLua {
+    /// Loads `src` into the Lua instance.
+    ///
+    /// # Errors
+    /// The instance's load error class.
+    pub fn new(src: &[u8], names: &NameTables) -> Result<Self, ScriptError> {
+        let mut buf = vec![0u8; 1 << 18];
+        let n = wire::encode_names(names);
+        buf[..src.len()].copy_from_slice(src);
+        buf[src.len()..src.len() + n.len()].copy_from_slice(&n);
+        match remote_new(buf.as_ptr(), src.len() as u32, n.len() as u32) {
+            0 => Ok(Self { buf, scratch: Vec::with_capacity(1 << 16), faulted: false, faults: 0, err: None }),
+            2 => Err(ScriptError::BudgetExceeded),
+            3 => Err(ScriptError::MemoryLimit),
+            c => Err(ScriptError::Load(format!("remote load error class {c}"))),
+        }
+    }
+
+    fn call(&mut self, kind: u32, switch: u32, closed: u32, ctx: &mut HostCtx) {
+        let len = wire::write_input(&mut self.buf, ctx.view, ctx.rng, ctx.cmd, &mut self.scratch);
+        let out = remote_call(kind, switch, closed, self.buf.as_mut_ptr(), len as u32);
+        if out == 0 {
+            // The Lua instance trapped (JS caught it): treat as a fault.
+            self.faulted = true;
+            self.faults += 1;
+            self.err = Some(ScriptError::Runtime("lua instance trapped".into()));
+            return;
+        }
+        let (rng, faulted, faults) = wire::read_output(&self.buf, ctx.cmd);
+        *ctx.rng = rng;
+        if faults != self.faults {
+            self.err = Some(ScriptError::Runtime("remote fault".into()));
+        }
+        self.faulted = faulted;
+        self.faults = faults;
+    }
+}
+
+impl TableScriptBackend for RemoteLua {
+    fn on_init(&mut self, ctx: &mut HostCtx) {
+        self.call(0, 0, 0, ctx);
+    }
+    fn on_tick(&mut self, ctx: &mut HostCtx) {
+        self.call(1, 0, 0, ctx);
+    }
+    fn on_switch_edge(&mut self, switch: SwitchId, edge: SwitchEdge, ctx: &mut HostCtx) {
+        self.call(2, u32::from(switch.0), u32::from(edge == SwitchEdge::Closed), ctx);
+    }
+    fn apply_reload(&mut self, _source: &[u8]) -> Result<(), ScriptError> {
+        Err(ScriptError::Load("remote backend: reload not prototyped".into()))
+    }
+}
+
+impl Introspect for RemoteLua {
+    fn overflow(&self) -> u32 {
+        0
+    }
+    fn faulted(&self) -> bool {
+        self.faulted
+    }
+    fn faults(&self) -> u32 {
+        self.faults
+    }
+    fn error(&self) -> Option<&ScriptError> {
+        self.err.as_ref()
+    }
+}
