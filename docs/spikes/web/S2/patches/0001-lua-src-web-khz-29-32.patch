+++ b/third_party/lua-src/lua-5.4.9/lkhznum.c
@@ -0,0 +1,219 @@
+/*
+** KHZ (web, spike S2): number conversions that give the same result on
+** every target (see KHZ_PATCHES.md, patches 29-30 proposed).
+**
+** khz_strx2number: hexadecimal numerals ("0x1.8p3"), correctly rounded
+**   (round to nearest, ties to even), overflow to +-HUGE_VAL. Replaces the
+**   C99 'strtod' Lua uses for them: glibc's is correctly rounded, wasi-libc's
+**   (musl with 128-bit long double) is off by one ulp for mantissas longer
+**   than about 15 hex digits, so the same source constant could differ
+**   natively and in the browser. For every input this returns what glibc's
+**   strtod returns.
+**
+** khz_number2strx: '%a'/'%A' formatting with glibc's output on every
+**   target. Normal numbers, zero, infinities and NaN go to the C library
+**   (glibc and musl agree on them, including precision, rounding carries and
+**   flags); subnormals are printed as glibc does, "0x0.<hex>p-1022" (musl
+**   and Apple's libc normalise them to "0x1.<hex>p-10xx").
+**
+** Plain C99, double ('lua_Number') only.
+*/
+
+#define lkhznum_c
+#define LUA_CORE
+
+#include "lprefix.h"
+
+#include <float.h>
+#include <locale.h>
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "lua.h"
+
+#include "lctype.h"
+#include "lobject.h"
+
+
+static int khz_hexval (int c) {
+  if (lisdigit(c)) return c - '0';
+  return (ltolower(c) - 'a') + 10;
+}
+
+
+lua_Number khz_strx2number (const char *s, char **endptr) {
+  const char *p = s;
+  int neg = 0, any = 0, dot = 0, sticky = 0;
+  unsigned long long m = 0;  /* significant bits read (< 2^61) */
+  long e = 0;  /* binary exponent of the last digit of 'm' */
+  int nb, keep, drop;
+  long top;
+  while (lisspace(cast_uchar(*p))) p++;
+  if (*p == '-') { neg = 1; p++; }
+  else if (*p == '+') p++;
+  if (!(p[0] == '0' && (p[1] == 'x' || p[1] == 'X'))) {
+    *endptr = (char *)s;  /* not a hexadecimal numeral */
+    return 0;
+  }
+  p += 2;
+  for (;; p++) {
+    int d;
+    if (*p == '.') {
+      if (dot) break;
+      dot = 1;
+      continue;
+    }
+    if (!lisxdigit(cast_uchar(*p))) break;
+    d = khz_hexval(cast_uchar(*p));
+    any = 1;
+    if (m < (1ULL << 57)) {
+      m = m * 16 + (unsigned)d;
+      if (dot) e -= 4;
+    }
+    else {  /* beyond 57 bits: only whether anything is nonzero matters */
+      sticky |= (d != 0);
+      if (!dot) e += 4;
+    }
+  }
+  if (!any) {  /* "0x" with no digit: no hexadecimal conversion */
+    *endptr = (char *)s;
+    return 0;
+  }
+  if (*p == 'p' || *p == 'P') {  /* optional binary exponent */
+    const char *q = p + 1;
+    int eneg = 0;
+    long x = 0;
+    if (*q == '-') { eneg = 1; q++; }
+    else if (*q == '+') q++;
+    if (lisdigit(cast_uchar(*q))) {
+      while (lisdigit(cast_uchar(*q))) {
+        if (x < 100000) x = x * 10 + (*q - '0');  /* saturate */
+        q++;
+      }
+      e += eneg ? -x : x;
+      p = q;
+    }  /* else the 'p' is not part of the numeral (as with strtod) */
+  }
+  *endptr = (char *)p;
+  if (m == 0) return neg ? -(lua_Number)0 : (lua_Number)0;
+  for (nb = 0; nb < 64 && (m >> nb) != 0; nb++) {}
+  top = e + nb - 1;  /* exponent of the leading bit */
+  if (top > DBL_MAX_EXP)  /* far too large */
+    return neg ? -(lua_Number)HUGE_VAL : (lua_Number)HUGE_VAL;
+  if (top >= DBL_MIN_EXP - 1)
+    keep = DBL_MANT_DIG;  /* normal */
+  else if (top >= DBL_MIN_EXP - DBL_MANT_DIG - 2)
+    keep = DBL_MANT_DIG - (int)((DBL_MIN_EXP - 1) - top);  /* subnormal */
+  else
+    return neg ? -(lua_Number)0 : (lua_Number)0;  /* below half the least subnormal */
+  drop = nb - keep;
+  if (drop > 0) {
+    unsigned long long kept, rem, half;
+    int up;
+    if (keep <= 0) {  /* every bit is dropped: compare with half the least subnormal */
+      /* value = m * 2^e, half of 2^(DBL_MIN_EXP - DBL_MANT_DIG) */
+      kept = 0;
+      if (keep == 0) {  /* top == least-subnormal exponent - 1: value in [half, 1) ulp */
+        unsigned long long lead = 1ULL << (nb - 1);
+        up = (m != lead) || sticky;  /* exactly half: ties to even (0) */
+      }
+      else
+        up = 0;
+      return (neg ? -1 : 1) * l_mathop(ldexp)((lua_Number)up,
+                                            DBL_MIN_EXP - DBL_MANT_DIG);
+    }
+    kept = m >> drop;
+    rem = m & ((1ULL << drop) - 1);
+    half = 1ULL << (drop - 1);
+    up = rem > half || (rem == half && (sticky || (kept & 1)));
+    kept += (unsigned)up;
+    return (neg ? -1 : 1) * l_mathop(ldexp)((lua_Number)kept, (int)(e + drop));
+  }
+  return (neg ? -1 : 1) * l_mathop(ldexp)((lua_Number)m, (int)e);
+}
+
+
+int khz_number2strx (char *buff, int sz, const char *fmt, lua_Number x) {
+  int left = 0, plus = 0, space = 0, alt = 0, zero = 0, width = 0, prec = -1;
