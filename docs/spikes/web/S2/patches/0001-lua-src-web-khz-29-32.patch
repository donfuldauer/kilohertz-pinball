@@ -0,0 +1,68 @@
+/* KHZ (web, spike S2): support code for Lua 5.4 on wasm32-unknown-unknown.
+ *
+ * The browser build compiles the Lua core and the libraries the sandbox can
+ * load (base, string, table, math, utf8, coroutine) against a wasi-libc
+ * sysroot, but not liolib.c, loslib.c, loadlib.c or ldblib.c: the sandbox
+ * never opens io, os, package or debug, and leaving them out keeps file,
+ * process and dynamic-library code out of the module. mlua still names their
+ * openers, so they exist here and refuse.
+ *
+ * wasi-libc's few remaining system-call imports (reached only from code the
+ * engine never runs: luaL_loadfilex's fopen, stdio flushing, time()) are
+ * defined here as failing functions, so the final module imports nothing from
+ * `wasi_snapshot_preview1` and no browser-side WASI shim exists.
+ */
+#include "lua.h"
+#include "lauxlib.h"
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+
+static int khz_absent (lua_State *L) {
+  return luaL_error(L, "this library is not available in the web build");
+}
+LUAMOD_API int luaopen_io (lua_State *L) { return khz_absent(L); }
+LUAMOD_API int luaopen_os (lua_State *L) { return khz_absent(L); }
+LUAMOD_API int luaopen_package (lua_State *L) { return khz_absent(L); }
+LUAMOD_API int luaopen_debug (lua_State *L) { return khz_absent(L); }
+
+/* The only stdio Lua still names is luaL_loadfilex's (dofile/loadfile, which
+ * the sandbox removes): no file can be opened. Defining these keeps wasi-libc's
+ * FILE machinery, and the __stdio_exit destructor it registers, out of the
+ * module (with it, wasm-ld wraps every export in a call to the destructors). */
+FILE *const stdin = 0;
+FILE *fopen (const char *restrict path, const char *restrict mode) {
+  (void)path; (void)mode; errno = ENOENT; return 0; }
+FILE *freopen (const char *restrict path, const char *restrict mode, FILE *restrict f) {
+  (void)path; (void)mode; (void)f; errno = ENOENT; return 0; }
+int fclose (FILE *f) { (void)f; return EOF; }
+int getc (FILE *f) { (void)f; return EOF; }
+size_t fread (void *restrict b, size_t size, size_t n, FILE *restrict f) {
+  (void)b; (void)size; (void)n; (void)f; return 0; }
+int ferror (FILE *f) { (void)f; return 1; }
+int feof (FILE *f) { (void)f; return 1; }
+
+/* WASI preview1 imports: every call fails with ENOSYS (52), or EBADF (8) for
+ * descriptor operations. Definitions win over wasi-libc's import
+ * declarations at link time. */
+#define KHZ_ENOSYS 52
+#define KHZ_EBADF 8
+#define KHZ_WASI(name) \
+  int32_t __imported_wasi_snapshot_preview1_##name
+KHZ_WASI(fd_write)(int32_t a, int32_t b, int32_t c, int32_t d) { (void)a; (void)b; (void)c; (void)d; return KHZ_EBADF; }
+KHZ_WASI(fd_read)(int32_t a, int32_t b, int32_t c, int32_t d) { (void)a; (void)b; (void)c; (void)d; return KHZ_EBADF; }
+KHZ_WASI(fd_close)(int32_t a) { (void)a; return KHZ_EBADF; }
+KHZ_WASI(fd_renumber)(int32_t a, int32_t b) { (void)a; (void)b; return KHZ_EBADF; }
+KHZ_WASI(fd_seek)(int32_t a, int64_t b, int32_t c, int32_t d) { (void)a; (void)b; (void)c; (void)d; return KHZ_EBADF; }
+KHZ_WASI(fd_fdstat_get)(int32_t a, int32_t b) { (void)a; (void)b; return KHZ_EBADF; }
+KHZ_WASI(fd_fdstat_set_flags)(int32_t a, int32_t b) { (void)a; (void)b; return KHZ_EBADF; }
+KHZ_WASI(fd_filestat_get)(int32_t a, int32_t b) { (void)a; (void)b; return KHZ_EBADF; }
+KHZ_WASI(fd_prestat_get)(int32_t a, int32_t b) { (void)a; (void)b; return KHZ_EBADF; }
+KHZ_WASI(fd_prestat_dir_name)(int32_t a, int32_t b, int32_t c) { (void)a; (void)b; (void)c; return KHZ_EBADF; }
+KHZ_WASI(path_open)(int32_t a, int32_t b, int32_t c, int32_t d, int32_t e, int64_t f, int64_t g, int32_t h, int32_t i) {
+  (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)g; (void)h; (void)i; return KHZ_ENOSYS; }
+KHZ_WASI(clock_time_get)(int32_t a, int64_t b, int32_t c) { (void)a; (void)b; (void)c; return KHZ_ENOSYS; }
+KHZ_WASI(environ_sizes_get)(int32_t a, int32_t b) { (void)a; (void)b; return KHZ_ENOSYS; }
+KHZ_WASI(environ_get)(int32_t a, int32_t b) { (void)a; (void)b; return KHZ_ENOSYS; }
+KHZ_WASI(random_get)(int32_t a, int32_t b) { (void)a; (void)b; return KHZ_ENOSYS; }
+void __imported_wasi_snapshot_preview1_proc_exit(int32_t a) { (void)a; __builtin_trap(); }
