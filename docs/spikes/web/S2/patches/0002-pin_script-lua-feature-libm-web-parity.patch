--- /dev/null
+++ b/crates/pin_script/src/lua/libm_abi.rs
@@ -0,0 +1,34 @@
+//! KHZ (web spike S2): the transcendental functions the patched Lua calls
+//! when built with `KHZ_LUA_MATH` (third_party/lua-src: `KHZ_MATHOP`), so
+//! `math.sin`, `^` and friends give the same bits on every target (the
+//! engine's Rust `libm`, D9) instead of the platform C library's.
+#![allow(unsafe_code)]
+
+macro_rules! khz1 {
+    ($($name:ident => $f:path),* $(,)?) => {$(
+        #[doc = concat!("`", stringify!($name), "` for the patched Lua (Rust libm).")]
+        #[unsafe(no_mangle)]
+        pub extern "C" fn $name(x: f64) -> f64 {
+            $f(x)
+        }
+    )*};
+}
+
+khz1! {
+    khz_sin => libm::sin, khz_cos => libm::cos, khz_tan => libm::tan,
+    khz_asin => libm::asin, khz_acos => libm::acos, khz_exp => libm::exp,
+    khz_log => libm::log, khz_log2 => libm::log2, khz_log10 => libm::log10,
+    khz_sinh => libm::sinh, khz_cosh => libm::cosh, khz_tanh => libm::tanh,
+}
+
+/// `atan2` for the patched Lua (Rust libm).
+#[unsafe(no_mangle)]
+pub extern "C" fn khz_atan2(y: f64, x: f64) -> f64 {
+    libm::atan2(y, x)
+}
+
+/// `pow` for the patched Lua (Rust libm).
+#[unsafe(no_mangle)]
+pub extern "C" fn khz_pow(x: f64, y: f64) -> f64 {
+    libm::pow(x, y)
+}
