+/// S8: per-tick fuel statistics (max with its tick, p99, p50) over ticks 1.. .
+fn s8_tick_stats(v: &[(u32, u64)]) -> String {
+    let t: Vec<(u32, u64)> = v.iter().skip(1).copied().collect();
+    if t.is_empty() {
+        return String::new();
+    }
+    let pct = |mut x: Vec<u64>, p: f64| {
+        x.sort_unstable();
+        x[((x.len() - 1) as f64 * p).round() as usize]
+    };
+    let cb: Vec<u64> = t.iter().map(|x| u64::from(x.0)).collect();
+    let fu: Vec<u64> = t.iter().map(|x| x.1).collect();
+    let (mut mc, mut tc, mut mf, mut tf) = (0, 0, 0, 0);
+    for (i, x) in t.iter().enumerate() {
+        if u64::from(x.0) > mc {
+            mc = u64::from(x.0);
+            tc = i + 1;
+        }
+        if x.1 > mf {
+            mf = x.1;
+            tf = i + 1;
+        }
+    }
+    format!(
+        "s8_callbacks_per_tick max={mc} (tick {tc}) p99={} p50={} s8_fuel_per_tick max={mf} (tick {tf}) p99={} p50={} total={}",
+        pct(cb.clone(), 0.99),
+        pct(cb, 0.5),
+        pct(fu.clone(), 0.99),
+        pct(fu.clone(), 0.5),
+        fu.iter().sum::<u64>()
+    )
+}
diff -ruN S4/repo/crates/s4_rules/src/s8adv.rs S8/s4repo/crates/s4_rules/src/s8adv.rs
--- S4/repo/crates/s4_rules/src/s8adv.rs	1970-01-01 00:00:00.000000000 +0000
+++ S8/s4repo/crates/s4_rules/src/s8adv.rs	2026-11-20 21:26:54.815369865 +0000
@@ -0,0 +1,125 @@
+//! S8: the worst-case adversarial tick for Wasm rules — `edges` switch
+//! edges plus `on_tick`, every callback looping just under the per-callback
+//! fuel budget — with or without the per-tick aggregate cap (env
+//! `S8_TICK_CAP`, read by the wasmi backend). Spike tooling.
+
+use crate::run::{Design, load};
+use pin_core::ids::SwitchId;
+use pin_core::{HostCommandQueue, HostCtx, HostView, Pcg32, SeedableRng, SwitchEdge};
+use pin_script::NameTables;
+use pin_script::wasm::WasmConfig;
+use std::fmt::Write as _;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+/// Per-tick aggregate cap for new backends (0: off). Native: initialised
+/// from env `S8_TICK_CAP`; web: `s8_set_tick_cap`.
+static TICK_CAP: AtomicU64 = AtomicU64::new(u64::MAX);
+
+/// Sets the cap new backends start with (0: off).
+pub fn set_tick_cap(cap: u64) {
+    TICK_CAP.store(cap, Ordering::Relaxed);
+}
+
+/// The cap new backends start with.
+#[must_use]
+pub fn tick_cap() -> Option<u64> {
+    let mut c = TICK_CAP.load(Ordering::Relaxed);
+    if c == u64::MAX {
+        c = std::env::var("S8_TICK_CAP").ok().and_then(|v| v.parse().ok()).unwrap_or(0);
+        TICK_CAP.store(c, Ordering::Relaxed);
+    }
+    (c != 0).then_some(c)
+}
+
+const IMPORTS: &str = r#"(import "pinball" "tick" (func $tick (result i64)))"#;
+
+fn module(n: u32, body: &str) -> Vec<u8> {
+    let w = format!(
+        r#"(module {IMPORTS} (memory (export "memory") 1)
+  (func $work (local $i i32) (loop $l {body} (local.set $i (i32.add (local.get $i) (i32.const 1))) (br_if $l (i32.lt_u (local.get $i) (i32.const {n})))))
+  (func (export "on_init")) (func (export "on_switch_edge") (param i32 i32) (call $work))
+  (func (export "on_tick") (call $work)))"#
+    );
+    wat::parse_str(&w).unwrap_or_else(|e| panic!("{e}"))
+}
+
+fn body(mix: &str) -> &'static str {
+    match mix {
+        "host_tick" => "(drop (call $tick))",
+        "call" => "",
+        _ => "(nop)",
+    }
+}
+
+/// Runs the adversarial tick; returns one outcome line and one timing line.
+#[must_use]
+pub fn run(design: Design, mix: &str, edges: u64, reps: u32, clock: Option<fn() -> f64>) -> String {
+    let names = NameTables::default();
+    let cfg = WasmConfig::engine();
+    let fits = |n: u32| {
+        let Ok(mut b) = load(design, &module(n, body(mix)), &names, cfg) else {
+            return false;
+        };
+        let view = HostView { tick: 1, ..HostView::default() };
+        let mut rng = Pcg32::seed_from_u64(1);
+        let mut cmd = HostCommandQueue::default();
+        b.on_tick(&mut HostCtx { view: &view, rng: &mut rng, cmd: &mut cmd });
+        !b.is_faulted()
+    };
+    let (mut lo, mut hi) = (0u32, 1u32);
+    while fits(hi) && hi < 1 << 26 {
+        lo = hi;
+        hi *= 2;
+    }
+    while hi - lo > 1 {
+        let m = lo + (hi - lo) / 2;
+        if fits(m) {
+            lo = m;
+        } else {
+            hi = m;
+        }
+    }
+    let n = lo * 98 / 100;
+    let wasm = module(n, body(mix));
+    let mut walls = Vec::new();
+    let mut line = String::new();
+    for rep in 0..reps.max(1) {
+        let mut b = load(design, &wasm, &names, cfg).expect("load");
+        let view = HostView { tick: 1, ..HostView::default() };
+        let mut rng = Pcg32::seed_from_u64(7);
+        let mut cmd = HostCommandQueue::default();
+        let (mut fuel, mut ran) = (0u64, 0u32);
+        let t0 = clock.map(|c| c());
+        for e in 0..edges {
+            let was = b.is_faulted();
+            b.on_switch_edge(SwitchId((e % 64) as u16), SwitchEdge::Closed, &mut HostCtx { view: &view, rng: &mut rng, cmd: &mut cmd });
+            if !was {
+                fuel += b.last_fuel();
+                ran += 1;
+            }
+        }
+        let was = b.is_faulted();
+        b.on_tick(&mut HostCtx { view: &view, rng: &mut rng, cmd: &mut cmd });
+        if !was {
+            fuel += b.last_fuel();
+            ran += 1;
+        }
+        walls.push(clock.map_or(0.0, |c| c() - t0.unwrap_or(0.0)));
+        if rep == 0 {
+            line = format!(
+                "wasm mix={mix} design={} n_per_callback={n} edges={edges} cap={} callbacks_run={ran} fuel={fuel} faulted={} faults={} last_error={:?}",
+                design.name(),
+                tick_cap().map_or_else(|| "off".to_owned(), |c| c.to_string()),
+                b.is_faulted(),
+                b.fault_count(),
+                b.last_error()
+            );
+        }
+    }
+    walls.sort_by(f64::total_cmp);
+    let mut out = format!("{line}\n");
+    if clock.is_some() {
+        let _ = writeln!(out, "TIMING wall_ms min={:.3} median={:.3} max={:.3}", walls[0], walls[walls.len() / 2], walls[walls.len() - 1]);
+    }
+    out
+}
