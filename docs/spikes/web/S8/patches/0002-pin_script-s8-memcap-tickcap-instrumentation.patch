+/// S8: the vendored Lua was built with KHZ 33 (logical memory accounting).
+pub(crate) fn s8_logical_mem() -> bool {
+    // SAFETY: a pure function of the build.
+    unsafe { lua_khzfeatures() & 1 != 0 }
+}
+
+/// S8: compiled-in KHZ knobs (1 logical memory, 2 key order, 4 audit fixes).
+pub fn s8_features() -> i32 {
+    // SAFETY: a pure function of the build.
+    unsafe { lua_khzfeatures() }
+}
+
+/// S8: real-byte backstop for the host allocator when the cap is logical
+/// (KHZ 33): the logical cap trips first on every target (LP64 real sizes
+/// equal the logical ones; 32-bit real sizes are smaller), the backstop only
+/// bounds what the logical accounting cannot see.
+pub(crate) const S8_BACKSTOP_FACTOR: usize = 2;
+
+/// Applies the memory cap to a fresh state: the host allocator's real-byte
+/// limit, or (KHZ 33) the logical cap plus a real-byte backstop.
+pub(crate) fn apply_memory_cap(lua: &Lua, cap: usize) -> mlua::Result<()> {
+    if s8_logical_mem() {
+        lua.set_memory_limit(cap.saturating_mul(S8_BACKSTOP_FACTOR))?;
+        // SAFETY: plain setter on the live main state.
+        unsafe {
+            lua.exec_raw::<()>((), |state| lua_khzsetmemcap(state, cap))?;
+        }
+        Ok(())
+    } else {
+        lua.set_memory_limit(cap).map(drop)
+    }
 }
 
