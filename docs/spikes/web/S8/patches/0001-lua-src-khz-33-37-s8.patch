diff -ruN S2/repo/third_party/lua-src/lua-5.4.9/lkhzmem.h S8/repo/third_party/lua-src/lua-5.4.9/lkhzmem.h
--- S2/repo/third_party/lua-src/lua-5.4.9/lkhzmem.h	1970-01-01 00:00:00.000000000 +0000
+++ S8/repo/third_party/lua-src/lua-5.4.9/lkhzmem.h	2026-11-20 20:56:44.551996276 +0000
@@ -0,0 +1,61 @@
+/*
+** KHZ 33 (web spike S8): logical memory sizes.
+** With KHZ_LOGICAL_MEM every allocation is accounted (GC debt, the GC pause
+** estimate, the emergency-collection charge of KHZ 19, LUA_GCCOUNT and the
+** logical heap cap 'lua_khzsetmemcap') with the sizes Lua 5.4.9's objects
+** have on an LP64 target (x86_64, aarch64), whatever the real layout is.
+** The same script therefore sees the same collection schedule and reaches
+** the cap at the same allocation on 32-bit (wasm32) and 64-bit targets.
+** On LP64 the constants equal the real sizes (checked at compile time in
+** lstate.c), except full-userdata payloads, which are charged a constant
+** (their real size is a host Rust type size, which is pointer-size
+** dependent). Without KHZ_LOGICAL_MEM the macros give the real sizes.
+*/
+#ifndef lkhzmem_h
+#define lkhzmem_h
+
+#if defined(KHZ_LOGICAL_MEM)
+#define KHZL_PTR        8u    /* TString*, Proto* vector elements */
+#define KHZL_TABLE      56u   /* sizeof(Table) */
+#define KHZL_UPVAL      40u   /* sizeof(UpVal) */
+#define KHZL_PROTO      128u  /* sizeof(Proto) */
+#define KHZL_LOCVAR     16u   /* sizeof(LocVar) */
+#define KHZL_UPVALDESC  16u   /* sizeof(Upvaldesc) */
+#define KHZL_LABELDESC  24u   /* sizeof(Labeldesc) */
+#define KHZL_CALLINFO   64u   /* sizeof(CallInfo) */
+#define KHZL_LX         208u  /* sizeof(LX) (LUA_EXTRASPACE = 8) */
+#define KHZL_LG         1648u /* sizeof(LG) */
+#define KHZL_TSHDR      24u   /* offsetof(TString, contents) */
+#define KHZL_UD0HDR     32u   /* offsetof(Udata0, bindata) */
+#define KHZL_UDHDR      40u   /* offsetof(Udata, uv) */
+#define KHZL_CCLHDR     32u   /* offsetof(CClosure, upvalue) */
+#define KHZL_LCLHDR     32u   /* offsetof(LClosure, upvals) */
+#define KHZL_UDPAYLOAD  64u   /* every full-userdata payload, whatever its size */
+#define khzl_udpayload(s)  ((void)(s), (size_t)KHZL_UDPAYLOAD)
+#else
+#define KHZL_PTR        sizeof(void *)
+#define KHZL_TABLE      sizeof(Table)
+#define KHZL_UPVAL      sizeof(UpVal)
+#define KHZL_PROTO      sizeof(Proto)
+#define KHZL_LOCVAR     sizeof(LocVar)
+#define KHZL_UPVALDESC  sizeof(Upvaldesc)
+#define KHZL_LABELDESC  sizeof(Labeldesc)
+#define KHZL_CALLINFO   sizeof(CallInfo)
+#define KHZL_LX         sizeof(LX)
+#define KHZL_LG         sizeof(LG)
+#define KHZL_TSHDR      offsetof(TString, contents)
+#define KHZL_UD0HDR     offsetof(Udata0, bindata)
+#define KHZL_UDHDR      offsetof(Udata, uv)
+#define KHZL_CCLHDR     offsetof(CClosure, upvalue)
+#define KHZL_LCLHDR     offsetof(LClosure, upvals)
+#define khzl_udpayload(s)  ((size_t)(s))
+#endif
+
+/* logical sizes of the variable-size objects (same shape as lobject.h/lfunc.h) */
+#define khzl_sizelstring(l)  (KHZL_TSHDR + ((l) + 1) * sizeof(char))
+#define khzl_sizeudata(nuv,nb)  \
+  (((nuv) == 0 ? KHZL_UD0HDR : KHZL_UDHDR + sizeof(UValue) * (nuv)) + khzl_udpayload(nb))
+#define khzl_sizeCclosure(n)  (cast_int(KHZL_CCLHDR) + cast_int(sizeof(TValue)) * (n))
+#define khzl_sizeLclosure(n)  (cast_int(KHZL_LCLHDR) + cast_int(KHZL_PTR) * (n))
+
+#endif
