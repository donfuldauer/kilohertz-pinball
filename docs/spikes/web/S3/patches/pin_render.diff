 fn storage_buffer(device: &wgpu::Device, label: &str, bytes: u64) -> wgpu::Buffer {
+    // S3 WebGL2 prototype: unused (never bound) on devices without storage
+    // buffers, where STORAGE usage is refused.
+    let usage = if device.limits().max_storage_buffers_per_shader_stage < 2 {
+        wgpu::BufferUsages::COPY_DST
