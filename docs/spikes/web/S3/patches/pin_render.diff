-        usage: wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST,
+        usage,
         mapped_at_creation: false,
     })
 }
 
+/// S3 WebGL2 prototype: the forward shader without the cluster storage
+/// buffers (bindings 2 and 3); the light loop runs over every light.
+pub fn forward_source_without_storage() -> String {
+    let s = FORWARD_SOURCE
+        .replace(
+            "@group(0) @binding(2) var<storage, read> cluster_ranges: array<vec2<u32>>;\n",
+            "",
+        )
+        .replace(
+            "@group(0) @binding(3) var<storage, read> cluster_indices: array<u32>;\n",
+            "",
+        )
+        .replace(
+            "    let ci = cluster_index(frag_xy, in.view_depth);\n    let range = cluster_ranges[ci];\n    let count = min(range.y, MAX_LIGHTS);\n",
+            "    let count = min(frame.cluster_dims.w, MAX_LIGHTS);\n",
+        )
+        .replace(
+            "        let li = cluster_indices[range.x + k];\n",
+            "        let li = k;\n",
+        );
+    debug_assert!(!s.contains("cluster_ranges") && !s.contains("cluster_indices"));
+    s
+}
