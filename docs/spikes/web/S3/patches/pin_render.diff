+// ---- S3 web spike additions (scratch copy only) -------------------------
+
+impl GpuContext {
+    /// S3 spike: a context from parts obtained elsewhere (e.g. the async web
+    /// path below). Native code keeps the blocking constructors.
+    pub fn from_parts(
+        instance: wgpu::Instance,
+        adapter: wgpu::Adapter,
+        device: wgpu::Device,
+        queue: wgpu::Queue,
+    ) -> GpuContext {
+        GpuContext {
+            inner: Some(Inner {
+                queue,
+                device,
+                adapter,
+                instance,
+            }),
+        }
+    }
+
+    /// S3 spike: [`with_instance`](Self::with_instance) without `pollster`
+    /// (the browser main thread cannot block on a JS promise). Same adapter
+    /// options, features and limits as the native path.
+    pub async fn request_async(
+        instance: wgpu::Instance,
+        opts: &GpuOptions,
+        compatible_surface: Option<&wgpu::Surface<'_>>,
+        limits_override: Option<wgpu::Limits>,
+    ) -> Result<GpuContext, GpuError> {
+        let adapter = instance
+            .request_adapter(&wgpu::RequestAdapterOptions {
+                power_preference: wgpu::PowerPreference::HighPerformance,
+                force_fallback_adapter: opts.force_fallback_adapter,
+                compatible_surface,
+                apply_limit_buckets: false,
+            })
+            .await
+            .map_err(|e| {
+                GpuError::NoAdapter(format!(
+                    "{e} (backends {:?}, force_fallback_adapter {})",
+                    opts.backends, opts.force_fallback_adapter
+                ))
+            })?;
+        // `limits_override` is a base; the adapter's texture size limits are
+        // always applied (`using_resolution`), as on the native path.
+        let limits = limits_override
+            .unwrap_or_else(|| engine_base_limits(&adapter))
+            .using_resolution(adapter.limits());
+        let (device, queue) = adapter
+            .request_device(&wgpu::DeviceDescriptor {
+                label: Some("pin_render"),
+                required_features: adapter.features() & optional_timestamp_features(),
+                required_limits: limits,
+                ..Default::default()
+            })
+            .await
+            .map_err(|e| GpuError::RequestDevice(e.to_string()))?;
+        Ok(GpuContext::from_parts(instance, adapter, device, queue))
+    }
+}
+
+/// S3 spike: the limits the engine requests from `adapter` today (same
+/// expression as [`GpuContext::with_instance`]).
+pub fn engine_limits(adapter: &wgpu::Adapter) -> wgpu::Limits {
+    wgpu::Limits::downlevel_defaults().using_resolution(adapter.limits())
+}
+
+/// S3 WebGL2 prototype: the base limits for `adapter`:
+/// `downlevel_webgl2_defaults` on an adapter without storage buffers
+/// (WebGL2 / GLES 3.0), `downlevel_defaults` otherwise (unchanged native).
+pub fn engine_base_limits(adapter: &wgpu::Adapter) -> wgpu::Limits {
+    if adapter.limits().max_storage_buffers_per_shader_stage == 0 {
+        wgpu::Limits::downlevel_webgl2_defaults()
+    } else {
+        wgpu::Limits::downlevel_defaults()
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+std::thread_local! {
+    static DEFERRED_SCOPE_ERRORS: core::cell::RefCell<Vec<String>> =
+        const { core::cell::RefCell::new(Vec::new()) };
+}
+
+/// S3 spike: errors of error scopes whose pop could not complete
+/// synchronously (WebGPU), recorded when the browser resolved them.
+pub fn take_deferred_scope_errors() -> Vec<String> {
+    #[cfg(target_arch = "wasm32")]
+    {
+        DEFERRED_SCOPE_ERRORS.with(|d| core::mem::take(&mut *d.borrow_mut()))
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        Vec::new()
+    }
+}
+
+/// S3 spike: pops `scope`. Native: blocks with `pollster` (unchanged
+/// behaviour). wasm32: returns the error when the pop is already complete
+/// (wgpu-core backends, i.e. WebGL2, complete it synchronously); otherwise
+/// (WebGPU: a JS promise) the pop finishes on the browser event loop, its
+/// error goes to [`take_deferred_scope_errors`], and this returns `None`.
+pub(crate) fn pop_scope(scope: wgpu::ErrorScopeGuard, what: &'static str) -> Option<wgpu::Error> {
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        let _ = what;
+        pollster::block_on(scope.pop())
+    }
+    #[cfg(target_arch = "wasm32")]
+    {
+        use core::future::Future;
+        let mut fut = Box::pin(scope.pop());
+        let mut cx = core::task::Context::from_waker(core::task::Waker::noop());
+        match fut.as_mut().poll(&mut cx) {
+            core::task::Poll::Ready(e) => e,
+            core::task::Poll::Pending => {
+                wasm_bindgen_futures::spawn_local(async move {
+                    if let Some(e) = fut.await {
+                        DEFERRED_SCOPE_ERRORS.with(|d| d.borrow_mut().push(format!("{what}: {e}")));
+                    }
+                });
+                None
+            }
+        }
+    }
+}
