+/// Without the built-in backends every `script_entry` is refused with the
+/// error `load_backend_with` gives; use
+/// [`Simulation::load_from_vfs_with_script`].
+#[cfg(not(feature = "native-backends"))]
+fn build_script(
+    entry: &str,
+    source: &[u8],
+    names: &NameTables,
+    cfg: &SimConfig,
+) -> Result<Script, ScriptError> {
+    match pin_script::load_backend_with(entry, source, names, cfg.lua, cfg.wasm) {
+        Err(e) => Err(e),
+        Ok(_) => Err(ScriptError::UnsupportedBackend(entry.to_owned())),
+    }
+}
