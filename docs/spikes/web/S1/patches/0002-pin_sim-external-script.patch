+/// A rules backend supplied by the caller
+/// ([`Simulation::load_from_vfs_with_script`]), e.g. a web build's backend
+/// or a recorded script-output stream. The defaults describe a backend that
+/// never faults, never overflows and is not allocation-exempt.
+pub trait ExternalScript: pin_core::TableScriptBackend {
+    /// Commands dropped because a `HostCommandQueue` list was full.
+    fn overflow_count(&self) -> u32 {
+        0
+    }
+    /// Whether the backend is in its safe "tilt" state after a fault.
+    fn is_faulted(&self) -> bool {
+        false
+    }
+    /// Faults since load.
+    fn fault_count(&self) -> u32 {
+        0
+    }
+    /// The error behind the last fault.
+    fn last_error(&self) -> Option<&ScriptError> {
+        None
+    }
+    /// Whether calls into the backend are exempt from the allocation guard
+    /// (PLAN.md §2.3 rule 4: only a VM allocating from its own capped arena).
+    fn alloc_exempt(&self) -> bool {
+        false
+    }
+}
+
 /// The rules backend, kept concrete so its fault state and overflow counter
 /// stay readable (DECISIONS.md "2.5 — script backend construction").
 pub(crate) enum Script {
+    #[cfg(feature = "native-backends")]
     Lua(Box<LuaScriptBackend>),
+    #[cfg(feature = "native-backends")]
     Wasm(Box<WasmScriptBackend>),
+    External(Box<dyn ExternalScript>),
+}
+
+impl Script {
+    /// The backend as the contract trait.
+    pub(crate) fn backend(&mut self) -> &mut dyn pin_core::TableScriptBackend {
+        match self {
+            #[cfg(feature = "native-backends")]
+            Script::Lua(b) => b.as_mut(),
+            #[cfg(feature = "native-backends")]
+            Script::Wasm(b) => b.as_mut(),
+            Script::External(b) => b.as_mut(),
+        }
+    }
+
+    /// Whether script calls run inside an allocation-guard exempt scope.
+    pub(crate) fn alloc_exempt(&self) -> bool {
+        match self {
+            #[cfg(feature = "native-backends")]
+            Script::Lua(_) => true,
+            #[cfg(feature = "native-backends")]
+            Script::Wasm(_) => false,
+            Script::External(b) => b.alloc_exempt(),
+        }
+    }
 }
 
