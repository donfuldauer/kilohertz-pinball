+++ b/crates/s1_harness/src/record.rs
@@ -0,0 +1,434 @@
+//! Native recording with the real Lua rules (feature `native`).
+//!
+//! [`RecordingScript`] wraps the engine's [`LuaScriptBackend`] (built with
+//! exactly the arguments `pin_sim`'s own loader uses) and writes the
+//! script-output stream; the scenario records the bot operations, input
+//! events and spawns. The recorder also writes the per-tick hashes of this
+//! real-Lua run and, for bot scenarios, the repo's own [`GameRecording`]
+//! so `pin_sim --replay-game` can cross-check the final hash.
+
+use crate::driver::Driver;
+use crate::io::{Op, Scenario, ScriptStreamWriter, digest_view};
+use crate::run::Every;
+use pin_core::ids::SwitchId;
+use pin_core::input::{CabinetInput, InputEvent};
+use pin_core::sim::TICK_NS;
+use pin_core::{HostCtx, Pcg32, Rng, ScriptError, SwitchEdge, TableScriptBackend};
+use pin_script::lua::{LuaConfig, LuaScriptBackend};
+use pin_sim::autoplay::{Bot, SkillLevel, SoakConfig, TableInfo, bot_seed, game_seed};
+use pin_sim::hash::Fnv64;
+use pin_sim::replay::{GameOp, GameOpSink, GameRecording};
+use pin_sim::{ExternalScript, SimConfig, Simulation};
+use std::path::Path;
+use std::sync::{Arc, Mutex};
+
+/// Largest number of `next_u32` draws one script step may make.
+pub const MAX_DRAWS: u32 = 1 << 24;
+
+fn count_draws(pre: &Pcg32, post: &Pcg32) -> u32 {
+    let mut r = pre.clone();
+    for n in 0..MAX_DRAWS {
+        if r == *post {
+            return n;
+        }
+        let _ = r.next_u32();
+    }
+    panic!("script made more than {MAX_DRAWS} RNG draws in one step");
+}
+
+/// The Lua backend plus a stream recorder.
+pub struct RecordingScript {
+    inner: Box<LuaScriptBackend>,
+    out: Arc<Mutex<ScriptStreamWriter>>,
+    pre: Option<Pcg32>,
+    digest: Fnv64,
+    fresh: bool,
+}
+
+impl RecordingScript {
+    fn begin(&mut self, ctx: &HostCtx) {
+        if self.fresh {
+            self.pre = Some(ctx.rng.clone());
+            self.digest = Fnv64::new();
+            self.fresh = false;
+        }
+    }
+
+    fn end(&mut self, ctx: &HostCtx) {
+        digest_view(&mut self.digest, ctx.view);
+        let pre = self.pre.take().expect("begin ran");
+        let draws = count_draws(&pre, ctx.rng);
+        self.out
+            .lock()
+            .unwrap()
+            .step(ctx.view.tick, draws, self.digest.finish(), ctx.cmd);
+        self.fresh = true;
+    }
+}
+
+impl TableScriptBackend for RecordingScript {
+    fn on_init(&mut self, ctx: &mut HostCtx) {
+        self.begin(ctx);
+        self.inner.on_init(ctx);
+        self.end(ctx);
+    }
+
+    fn on_tick(&mut self, ctx: &mut HostCtx) {
+        self.begin(ctx);
+        self.inner.on_tick(ctx);
+        self.end(ctx);
+    }
+
+    fn on_switch_edge(&mut self, switch: SwitchId, edge: SwitchEdge, ctx: &mut HostCtx) {
+        self.begin(ctx);
+        self.digest.write_u32(u32::from(switch.0));
+        self.digest.write_u8(u8::from(edge == SwitchEdge::Closed));
+        self.inner.on_switch_edge(switch, edge, ctx);
+    }
+
+    fn apply_reload(&mut self, source: &[u8]) -> Result<(), ScriptError> {
+        self.inner.apply_reload(source)
+    }
+}
+
+impl ExternalScript for RecordingScript {
+    fn overflow_count(&self) -> u32 {
+        self.inner.overflow_count()
+    }
+    fn is_faulted(&self) -> bool {
+        self.inner.is_faulted()
+    }
+    fn fault_count(&self) -> u32 {
+        self.inner.fault_count()
+    }
+    fn last_error(&self) -> Option<&ScriptError> {
+        self.inner.last_error()
+    }
+    fn alloc_exempt(&self) -> bool {
+        true
+    }
+}
+
+/// A recorded scenario and its outputs.
+pub struct Recorded {
+    /// The scenario.
+    pub scenario: Scenario,
+    /// The script-output stream bytes.
+    pub script: Vec<u8>,
+    /// The bot operations in the repo's format (bot scenarios).
+    pub game: Option<GameRecording>,
+    /// Hash lines of the real-Lua run.
+    pub hashes: Vec<u8>,
+    /// Summary.
+    pub summary: String,
+}
+
+fn load_recording(
+    bundle_zip: &[u8],
+    seed: u64,
+) -> Result<(Simulation, Arc<Mutex<ScriptStreamWriter>>), String> {
+    let vfs = crate::run::open_bundle(bundle_zip)?;
+    let out = Arc::new(Mutex::new(ScriptStreamWriter::default()));
+    let o2 = Arc::clone(&out);
+    let cfg = SimConfig {
+        seed,
+        ..SimConfig::default()
+    };
+    let lua = cfg.lua;
+    let sim = Simulation::load_from_vfs_with_script(&vfs, cfg, &mut |entry, src, names| {
+        if !entry.ends_with(".lua") {
+            return Err(ScriptError::UnsupportedBackend(entry.to_owned()));
+        }
+        Ok(Box::new(RecordingScript {
+            inner: Box::new(LuaScriptBackend::new(src, names, lua)?),
+            out: Arc::clone(&o2),
+            pre: None,
+            digest: Fnv64::new(),
+            fresh: true,
+        }) as Box<dyn ExternalScript>)
+    })
+    .map_err(|e| e.to_string())?;
+    let _: LuaConfig = lua;
+    Ok((sim, out))
+}
+
+fn line(out: &mut Vec<u8>, sim: &Simulation) {
+    out.extend_from_slice(
+        format!(
+            "{} {:016x} {:016x}\n",
+            sim.tick(),
+            sim.state_hash(),
+            crate::hashes::ext_hash(sim)
+        )
+        .as_bytes(),
+    );
+}
+
+struct Sink<'a> {
+    ops: &'a mut Vec<(u64, Op)>,
+    game: &'a mut GameRecording,
+}
+
+impl GameOpSink for Sink<'_> {
+    fn op(&mut self, tick: u64, op: GameOp) {
+        self.ops.push((tick, Op::Game(op)));
+        self.game.ops.push((tick, op));
+    }
+}
+
+/// Records `ticks` ticks of autoplay bot games on `bundle_zip`
+/// (`bundle_path` for the bot's table info): game 0 of the soak seed
+/// `seed`, then a fresh bot (next game seed) whenever a game ends (5 s
+/// without a ball after one was seen, or 10 s without any ball), so the
+/// run can be longer than one game.
+///
+/// # Errors
+/// Load failures.
+pub fn record_bot(
+    bundle_path: &Path,
+    bundle_zip: &[u8],
+    seed: u64,
+    ticks: u64,
+    skill: SkillLevel,
+    every: Every,
+) -> Result<Recorded, String> {
+    let info = TableInfo::load(bundle_path).map_err(|e| e.to_string())?;
+    let soak = SoakConfig::default();
+    let sim_seed = game_seed(seed, 0);
+    let (mut sim, out) = load_recording(bundle_zip, sim_seed)?;
+    let mut ops = Vec::new();
+    let mut game = GameRecording {
+        seed: sim_seed,
+        table_hash: sim.table_hash(),
+        ticks,
+        ops: Vec::new(),
+    };
+    let new_bot = |g: u32| {
+        Bot::new(bot_seed(game_seed(seed, g)), skill)
+            .with_table(&info)
+            .with_config(soak.bot)
+    };
+    let mut g = 0u32;
+    let mut bot = new_bot(g);
+    let (mut idle, mut bot_start) = (0u64, 0u64);
+    let mut hashes = Vec::new();
+    line(&mut hashes, &sim);
+    let mut max_balls = 0;
+    while sim.tick() < ticks {
+        bot.tick_recorded(
+            &mut sim,
+            &mut Sink {
+                ops: &mut ops,
+                game: &mut game,
+            },
+        );
+        sim.advance(1);
+        max_balls = max_balls.max(sim.balls_in_play());
+        if every.wants(sim.tick(), ticks) {
+            line(&mut hashes, &sim);
+        }
+        idle = if sim.balls_in_play() == 0 {
+            idle + 1
+        } else {
+            0
+        };
+        let over = bot.seen_ball() && idle >= soak.idle_end_ticks;
+        let no_ball = !bot.seen_ball()
+            && sim.balls_in_play() == 0
+            && sim.tick() - bot_start >= soak.start_timeout_ticks;
+        if over || no_ball {
+            g += 1;
+            bot = new_bot(g);
+            idle = 0;
+            bot_start = sim.tick();
+        }
+    }
+    let summary = format!(
+        "bot games started={} ticks={} state_hash={:016x} score={:?} max_balls={} script_faults={} overflows={}",
+        g + 1,
+        sim.tick(),
+        sim.state_hash(),
+        sim.score(0),
+        max_balls,
+        sim.script_fault_count(),
+        sim.script_queue_overflows()
+    );
+    let script = out.lock().unwrap().to_bytes();
+    Ok(Recorded {
+        scenario: Scenario {
+            seed: sim_seed,
+            table_hash: sim.table_hash(),
+            ticks,
+            ops,
+        },
+        script,
+        game: Some(game),
+        hashes,
+        summary,
+    })
+}
+
+/// `pin_sim`'s built-in input pattern ([`pin_sim::cli::pattern_events`])
+/// plus a launch press of 300 ms every 5 s (from tick 2000), so served
+/// balls enter play.
+pub fn pattern_with_launch(tick: u64, out: &mut Vec<InputEvent>) {
+    pin_sim::cli::pattern_events(tick, out);
+    let ts = tick.saturating_sub(1) * TICK_NS + TICK_NS / 2;
+    match tick % 5000 {
+        2000 => out.push(InputEvent::button(ts, CabinetInput::Launch, true)),
+        2300 => out.push(InputEvent::button(ts, CabinetInput::Launch, false)),
+        _ => {}
+    }
+}
+
+/// Spawn positions of the multiball scenario: a 4 x 4 grid over the upper
+/// playfield (table frame, m), 2 mm above resting height, rolling down.
+#[must_use]
+pub fn grid_spawns(n: usize) -> Vec<Op> {
+    (0..n)
+        .map(|i| {
+            let (col, row) = ((i % 4) as f32, (i / 4) as f32);
+            Op::Spawn {
+                profile: 0,
+                layer: 0,
+                pos: [0.12 + 0.09 * col, 0.62 + 0.07 * row, 0.0155],
+                vel: [0.15 * (col - 1.5), -0.4, 0.0],
+            }
+        })
+        .collect()
+}
+
+/// Records `ticks` ticks of [`pattern_with_launch`] input (or, without
+/// `launch`, exactly `pin_sim --ticks`'s built-in pattern), with `spawns`
+/// balls spawned before tick 1.
+///
+/// # Errors
+/// Load failures.
+pub fn record_pattern(
+    bundle_zip: &[u8],
+    seed: u64,
+    ticks: u64,
+    spawns: usize,
+    launch: bool,
+    every: Every,
+) -> Result<Recorded, String> {
+    let (mut sim, out) = load_recording(bundle_zip, seed)?;
+    let mut ops: Vec<(u64, Op)> = grid_spawns(spawns).into_iter().map(|o| (1, o)).collect();
+    let mut ev = Vec::new();
+    for t in 1..=ticks {
+        ev.clear();
+        if launch {
+            pattern_with_launch(t, &mut ev);
+        } else {
+            pin_sim::cli::pattern_events(t, &mut ev);
+        }
+        ops.extend(ev.iter().map(|e| (t, Op::Input(*e))));
+    }
+    let scenario = Scenario {
+        seed,
+        table_hash: sim.table_hash(),
+        ticks,
+        ops,
+    };
+    let mut drv = Driver::new(&scenario);
+    let mut hashes = Vec::new();
+    line(&mut hashes, &sim);
+    let mut max_balls = 0;
+    while sim.tick() < ticks {
+        drv.advance(&mut sim)?;
+        max_balls = max_balls.max(sim.balls_in_play());
+        if every.wants(sim.tick(), ticks) {
+            line(&mut hashes, &sim);
+        }
+    }
+    let summary = format!(
+        "pattern spawns={spawns} ticks={} state_hash={:016x} score={:?} max_balls={} script_faults={} overflows={}",
+        sim.tick(),
+        sim.state_hash(),
+        sim.score(0),
+        max_balls,
+        sim.script_fault_count(),
+        sim.script_queue_overflows()
+    );
+    let script = out.lock().unwrap().to_bytes();
+    Ok(Recorded {
+        scenario,
+        script,
+        game: None,
+        hashes,
+        summary,
+    })
+}
+
+/// Runs `scn` through the repo's own loader and built-in Lua backend
+/// (`Simulation::load`, no wrapper); returns the hash lines. Shows the
+/// wrapper and the playback reproduce the engine's real path.
+///
+/// # Errors
+/// Load and scenario failures.
+pub fn run_builtin(bundle_path: &Path, scn: &Scenario, every: Every) -> Result<Vec<u8>, String> {
+    let mut sim = Simulation::load(
+        bundle_path,
+        SimConfig {
+            seed: scn.seed,
+            ..SimConfig::default()
+        },
+    )
+    .map_err(|e| e.to_string())?;
+    if sim.table_hash() != scn.table_hash {
+        return Err(format!(
+            "folder table hash {:016x} differs from the scenario's (zip) {:016x}",
+            sim.table_hash(),
+            scn.table_hash
+        ));
+    }
+    let mut drv = Driver::new(scn);
+    let mut hashes = Vec::new();
+    line(&mut hashes, &sim);
+    while sim.tick() < scn.ticks {
+        drv.advance(&mut sim)?;
+        if every.wants(sim.tick(), scn.ticks) {
+            line(&mut hashes, &sim);
+        }
+    }
+    Ok(hashes)
+}
+
+/// Per-tick cost with the engine's real Lua backend (`Simulation::load`,
+/// no wrapper, no hashing): JSON with mean/p50/p99/p99.9/max after
+/// `warmup` ticks. Context for the playback-backend numbers.
+///
+/// # Errors
+/// Load and scenario failures.
+pub fn bench_builtin(bundle_path: &Path, scn: &Scenario, warmup: u64) -> Result<String, String> {
+    let mut sim = Simulation::load(
+        bundle_path,
+        SimConfig {
+            seed: scn.seed,
+            ..SimConfig::default()
+        },
+    )
+    .map_err(|e| e.to_string())?;
+    let mut drv = Driver::new(scn);
+    let mut v = Vec::with_capacity(scn.ticks as usize);
+    let epoch = std::time::Instant::now();
+    while sim.tick() < scn.ticks {
+        let t = drv.prepare(&mut sim)?;
+        let t0 = epoch.elapsed().as_nanos() as f64;
+        drv.step(&mut sim, t);
+        let t1 = epoch.elapsed().as_nanos() as f64;
+        if t > warmup {
+            v.push(t1 - t0);
+        }
+    }
+    let st = crate::run::Stats::of(&mut v);
+    Ok(format!(
+        "{{\"lua_per_tick_steady\":{{\"n\":{},\"mean_us\":{:.3},\"p50_us\":{:.3},\"p99_us\":{:.3},\"p999_us\":{:.3},\"max_us\":{:.3}}}}}",
+        st.n,
+        st.mean / 1e3,
+        st.p50 / 1e3,
+        st.p99 / 1e3,
+        st.p999 / 1e3,
+        st.max / 1e3
+    ))
+}
--- a/crates/s1_harness/src/driver.rs
+++ b/crates/s1_harness/src/driver.rs
@@ -0,0 +1,90 @@
+//! Steps a [`Simulation`] through a [`Scenario`].
+
+use crate::io::{Op, Scenario};
+use arrayvec::ArrayVec;
+use pin_core::input::InputEvent;
+use pin_core::profiles::BUILTIN_PROFILE_NAMES;
+use pin_core::sim::SimStep;
+use pin_core::snapshot::FrameStateSnapshot;
+use pin_sim::Simulation;
+use pin_sim::replay::apply_game_op;
+
+/// Most input events fed with one tick.
+pub const MAX_INPUTS_PER_TICK: usize = 128;
+
+/// A scenario cursor.
+pub struct Driver {
+    ops: Vec<(u64, Op)>,
+    next: usize,
+    inputs: ArrayVec<InputEvent, MAX_INPUTS_PER_TICK>,
+    out: FrameStateSnapshot,
+    /// Ticks to run.
+    pub ticks: u64,
+}
+
+impl Driver {
+    /// A driver for `scn`.
+    #[must_use]
+    pub fn new(scn: &Scenario) -> Self {
+        Self {
+            ops: scn.ops.clone(),
+            next: 0,
+            inputs: ArrayVec::new(),
+            out: FrameStateSnapshot::default(),
+            ticks: scn.ticks,
+        }
+    }
+
+    /// Applies the bot operations and spawns recorded before the next tick
+    /// and collects its input events; returns the tick number.
+    ///
+    /// # Errors
+    /// A message when an operation fails or a tick has too many inputs.
+    pub fn prepare(&mut self, sim: &mut Simulation) -> Result<u64, String> {
+        let tick = sim.tick() + 1;
+        self.inputs.clear();
+        while self.next < self.ops.len() && self.ops[self.next].0 <= tick {
+            let (t, op) = self.ops[self.next];
+            self.next += 1;
+            if t < tick {
+                continue;
+            }
+            match op {
+                Op::Game(g) => apply_game_op(sim, g).map_err(|e| e.to_string())?,
+                Op::Input(e) => self
+                    .inputs
+                    .try_push(e)
+                    .map_err(|_| format!("tick {tick}: more than {MAX_INPUTS_PER_TICK} inputs"))?,
+                Op::Spawn {
+                    profile,
+                    layer,
+                    pos,
+                    vel,
+                } => {
+                    let name = BUILTIN_PROFILE_NAMES
+                        .get(usize::from(profile))
+                        .ok_or("bad profile")?;
+                    // A full arena or a spawn inside geometry is part of
+                    // the recorded scenario; ignore failures alike.
+                    let _ = sim.spawn_ball_on_layer(name, layer, pos, vel);
+                }
+            }
+        }
+        Ok(tick)
+    }
+
+    /// Runs tick `tick` (from [`prepare`](Self::prepare)) with its inputs.
+    pub fn step(&mut self, sim: &mut Simulation, tick: u64) {
+        sim.step_1ms(tick, &self.inputs, &mut self.out);
+    }
+
+    /// [`prepare`](Self::prepare) then [`step`](Self::step).
+    ///
+    /// # Errors
+    /// As [`prepare`](Self::prepare).
+    pub fn advance(&mut self, sim: &mut Simulation) -> Result<u64, String> {
+        let t = self.prepare(sim)?;
+        self.step(sim, t);
+        Ok(t)
+    }
+}
--- a/crates/s1_harness/src/hashes.rs
+++ b/crates/s1_harness/src/hashes.rs
@@ -0,0 +1,107 @@
+//! Per-tick hashes: the repo's [`Simulation::state_hash`] plus a stronger
+//! supplementary hash over everything else the sim publishes.
+
+use pin_sim::Simulation;
+use pin_sim::hash::Fnv64;
+
+/// FNV-1a 64 over: `state_hash`; the full published snapshot (every ball,
+/// flipper incl. zipper offset, dynamic mesh transform, lamp and GI value as
+/// exact bits); each ball's magnetisation; the sim counters; the 64
+/// persistent values; the last applied command queue; the haptic events.
+/// It covers what `state_hash` leaves out (mechs, magnetisation, lamps,
+/// persist, command queue).
+#[must_use]
+pub fn ext_hash(sim: &Simulation) -> u64 {
+    let mut h = Fnv64::new();
+    h.write_u64(sim.state_hash());
+    let s = sim.snapshot();
+    h.write_u64(s.tick);
+    h.write_u8(s.ball_count);
+    for b in s.balls() {
+        for v in b
+            .position_m
+            .iter()
+            .chain(&b.velocity_m_s)
+            .chain(&b.angular_velocity_rad_s)
+        {
+            h.write_f32(*v);
+        }
+        for v in b.orientation {
+            h.write_f32(v);
+        }
+        h.write_u32(u32::from(b.profile.0));
+        h.write_u8(b.layer);
+    }
+    for f in s.flippers() {
+        h.write_u32(u32::from(f.id.0));
+        h.write_f32(f.angle_rad);
+        h.write_f32(f.angular_velocity_rad_s);
+        h.write_f32(f.zipper_offset_m);
+    }
+    for m in s.dynamic_meshes() {
+        for v in m.position_m.iter().chain(&m.orientation) {
+            h.write_f32(*v);
+        }
+    }
+    for l in s.lamps {
+        h.write_f32(l);
+    }
+    for g in s.gi {
+        h.write_f32(g);
+    }
+    for bh in sim.ball_handles() {
+        h.write_f32(sim.magnetisation(bh));
+    }
+    let c = sim.counters();
+    for v in [
+        c.edges_dropped,
+        c.haptics_dropped,
+        c.inputs_dropped,
+        c.spawns_failed,
+        c.ball_events_dropped,
+        c.balls_drained,
+        c.balls_escaped,
+    ] {
+        h.write_u32(v);
+    }
+    for k in 0..64u16 {
+        h.write_i64(sim.persist(k));
+    }
+    let q = sim.last_commands();
+    for &(c, ms) in &q.coil_pulses {
+        h.write_u32(u32::from(c.0) << 16 | u32::from(ms));
+    }
+    h.write_u8(0xA0);
+    for &(c, on) in &q.coil_holds {
+        h.write_u32(u32::from(c.0) << 1 | u32::from(on));
+    }
+    h.write_u8(0xA1);
+    for &(m, p) in &q.magnets {
+        h.write_u32(u32::from(m.0));
+        h.write_f32(p);
+    }
+    h.write_u8(0xA2);
+    for &(l, i) in &q.lamps {
+        h.write_u32(u32::from(l.0));
+        h.write_f32(i);
+    }
+    h.write_u8(0xA3);
+    for &(p, s) in &q.scores {
+        h.write_u8(p);
+        h.write_i64(s);
+    }
+    h.write_u8(0xA4);
+    for s in &q.display_scenes {
+        h.write_u32(u32::from(s.0));
+    }
+    for &(s, g) in &q.sounds {
+        h.write_u32(u32::from(s.0));
+        h.write_f32(g);
+    }
+    for e in sim.haptic_events() {
+        h.write_u64(e.tick);
+        h.write_u32(u32::from(e.source));
+        h.write_f32(e.strength);
+    }
+    h.finish()
+}
