+
+/// Recursion whose frames hold 1 KiB in linear memory (the shadow stack on
+/// wasm32): about `n` KiB of stack.
+#[inline(never)]
+#[must_use]
+pub fn recurse_big(n: u32) -> u64 {
+    let mut buf = [0u8; 1024];
+    buf[(n as usize) % 1024] = n as u8;
+    let buf = core::hint::black_box(&mut buf);
+    if n == 0 {
+        return u64::from(buf[0]);
+    }
+    recurse_big(n - 1).wrapping_add(u64::from(buf[(n as usize * 7) % 1024]))
+}
+
+/// Recursion with tiny frames that stay in wasm locals (the engine's own
+/// native call stack on wasm32, not the shadow stack).
+#[inline(never)]
+#[must_use]
+pub fn recurse_small(n: u32) -> u64 {
+    if core::hint::black_box(n) == 0 {
+        return 1;
+    }
+    recurse_small(n - 1)
+        .wrapping_mul(3)
+        .wrapping_add(u64::from(n))
+}
+
+#[cfg(target_arch = "wasm32")]
+unsafe extern "C" {
+    static __data_end: u8;
+    static __heap_base: u8;
+}
+
+/// Approximate stack pointer (address of a local in linear memory).
+#[inline(never)]
+#[must_use]
+pub fn approx_sp() -> usize {
+    let marker = core::hint::black_box(0u8);
+    core::hint::black_box(core::ptr::addr_of!(marker)) as usize
+}
+
+/// Linear-memory layout: stack pointer, data end and heap base.
+#[must_use]
+pub fn stack_layout() -> String {
+    #[cfg(target_arch = "wasm32")]
+    {
+        // Linker-defined symbols; only their addresses are taken.
+        let (data_end, heap_base) = (
+            core::ptr::addr_of!(__data_end) as usize,
+            core::ptr::addr_of!(__heap_base) as usize,
+        );
+        let sp = approx_sp();
+        format!(
+            "sp~{sp:#x} ({} KiB) __data_end={data_end:#x} __heap_base={heap_base:#x} layout={}",
+            sp / 1024,
+            if sp < data_end {
+                "stack-first (stack below data: overflow goes below 0 and traps)"
+            } else {
+                "data-first (overflow runs into data)"
+            }
+        )
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        format!("native: sp~{:#x}", approx_sp())
+    }
+}
+
+/// Runs `f` after painting `paint` bytes of unused stack below the current
+/// frame, and returns how many bytes below the paint start `f` touched
+/// (stack high-water mark of `f` relative to the caller). wasm32 only.
+#[cfg(target_arch = "wasm32")]
+pub fn stack_highwater<R>(paint: usize, f: impl FnOnce() -> R) -> (R, usize, usize) {
+    // Linker-defined symbol; only its address is taken.
+    let data_end = core::ptr::addr_of!(__data_end) as usize;
+    let sp = approx_sp();
+    let top = sp - 4096;
+    let floor = if sp < data_end { 4096 } else { data_end + 16 };
+    let lo = top.saturating_sub(paint).max(floor);
+    for a in lo..top {
+        // SAFETY: [lo, top) is unused stack below the live frames (the
+        // stack grows down and nothing lives below the current frame).
+        unsafe { core::ptr::write_volatile(a as *mut u8, 0xA5) };
+    }
+    let r = core::hint::black_box(f());
+    let mut lowest = top;
+    for a in lo..top {
+        // SAFETY: as above; reading the painted region.
+        if unsafe { core::ptr::read_volatile(a as *const u8) } != 0xA5 {
+            lowest = a;
+            break;
+        }
+    }
+    (r, top - lowest, top - lo)
+}
+
+/// Bit patterns of NaNs produced by arithmetic (A12): IEEE leaves the sign
+/// and payload of a generated NaN to the platform; wasm makes them
+/// nondeterministic (canonical or arithmetic NaN, any sign).
+#[must_use]
+pub fn nan_bits() -> String {
+    use core::hint::black_box as bb;
+    let z = bb(0.0f32);
+    let inf = bb(f32::INFINITY);
+    let payload = f32::from_bits(0x7fa0_0001); // signalling NaN with a payload
+    let qp = f32::from_bits(0x7fc0_1234); // quiet NaN with a payload
+    let neg = f32::from_bits(0xffc0_1234);
+    let cases: [(&str, f32); 9] = [
+        ("0/0", bb(z) / bb(z)),
+        ("inf-inf", bb(inf) - bb(inf)),
+        ("0*inf", bb(z) * bb(inf)),
+        ("sqrt(-1)", bb(-1.0f32).sqrt()),
+        ("snan+1", bb(payload) + bb(1.0)),
+        ("qnan_payload+1", bb(qp) + bb(1.0)),
+        ("neg_qnan_payload*1", bb(neg) * bb(1.0)),
+        ("min(qnan,1)", bb(qp).min(bb(1.0))),
+        ("libm::sqrtf(-1)", libm_sqrt(bb(-1.0))),
+    ];
+    cases
+        .iter()
+        .map(|(n, v)| format!("{n}={:08x}", v.to_bits()))
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+fn libm_sqrt(x: f32) -> f32 {
+    libm::sqrtf(x)
+}
+
+/// A13 bisection at the operation level: FNV-1a 64 digests of the exact
+/// result bits of the glam operations the sim uses (and a few it does not),
+/// over `n` PCG-generated inputs (unit quaternions, vectors in [-1, 1],
+/// matrices from translations/rotations), including signed zeros. Equal
+/// digests on two builds mean bit-identical results for every input.
+#[must_use]
+pub fn glam_ops(n: u32) -> String {
+    use glam::{Mat4, Quat, Vec3, Vec4};
+    use pin_core::{Rng, SeedableRng};
+    use pin_sim::hash::Fnv64;
+    let mut rng = pin_core::Pcg32::seed_from_u64(0x005E_ED51);
+    let mut f = move || {
+        let r = rng.next_u32();
+        if r % 97 == 0 {
+            if r & 1 == 0 { 0.0 } else { -0.0 }
+        } else {
+            (r >> 8) as f32 / (1u32 << 24) as f32 * 2.0 - 1.0
+        }
+    };
+    let names = [
+        "quat_mul",
+        "quat_normalize",
+        "quat_mul_vec3",
+        "quat_conj_mul_vec3",
+        "quat_from_rotation_arc",
+        "integrate_orientation",
+        "vec4_dot",
+        "vec4_length",
+        "vec4_normalize",
+        "vec4_min_max",
+        "mat4_mul_mat4",
+        "mat4_transform_point3",
+        "mat4_inverse",
+        "vec3_ops",
+        "libm_trig",
+    ];
+    let mut h = [Fnv64::new(); 15];
+    let w4 = |h: &mut Fnv64, v: [f32; 4]| v.iter().for_each(|x| h.write_u32(x.to_bits()));
+    let w3 = |h: &mut Fnv64, v: Vec3| v.to_array().iter().for_each(|x| h.write_u32(x.to_bits()));
+    for _ in 0..n {
+        let qa = Quat::from_xyzw(f(), f(), f(), f()).normalize();
+        let qb = Quat::from_xyzw(f(), f(), f(), f()).normalize();
+        let v = Vec3::new(f(), f(), f());
+        let w = Vec3::new(f() * 300.0, f() * 300.0, f() * 300.0);
+        let a = Vec4::new(f(), f(), f(), f());
+        let b = Vec4::new(f(), f(), f(), f());
+        w4(&mut h[0], (qa * qb).to_array());
+        w4(
+            &mut h[1],
+            Quat::from_xyzw(a.x, a.y, a.z, a.w).normalize().to_array(),
+        );
+        w3(&mut h[2], qa * v);
+        w3(&mut h[3], qa.conjugate() * v);
+        if v.length_squared() > 1e-6 {
+            w4(
+                &mut h[4],
+                Quat::from_rotation_arc(Vec3::Z, v.normalize()).to_array(),
+            );
+        }
+        w4(
+            &mut h[5],
+            pin_physics::ball::contact::integrate_orientation(qa, w, 0.001).to_array(),
+        );
+        h[6].write_u32(a.dot(b).to_bits());
+        h[7].write_u32(a.length().to_bits());
+        w4(&mut h[8], a.normalize_or_zero().to_array());
+        w4(&mut h[9], a.min(b).to_array());
+        w4(&mut h[9], a.max(b).to_array());
+        let ma = Mat4::from_rotation_translation(qa, v);
+        let mb = Mat4::from_scale_rotation_translation(Vec3::new(1.0 + a.x.abs(), 1.0, 2.0), qb, w);
+        (ma * mb)
+            .to_cols_array()
+            .iter()
+            .for_each(|x| h[10].write_u32(x.to_bits()));
+        w3(&mut h[11], mb.transform_point3(v));
+        mb.inverse()
+            .to_cols_array()
+            .iter()
+            .for_each(|x| h[12].write_u32(x.to_bits()));
+        w3(
+            &mut h[13],
+            v.cross(w).normalize_or_zero() + v * v.dot(w) - w.length() * v,
+        );
+        h[14].write_u32(libm::sinf(w.x).to_bits());
+        h[14].write_u32(libm::atan2f(w.y, w.z).to_bits());
+        h[14].write_u32(libm::expf(a.x * 10.0).to_bits());
+    }
+    names
+        .iter()
+        .zip(h.iter())
+        .map(|(n, h)| format!("{n}={:016x}", h.finish()))
+        .collect::<Vec<_>>()
+        .join(" ")
+}
