+//! Platform probes for A6 (std on wasm), A7 (panics) and A28 (stack).
+//! Each probe returns a description; a probe whose operation panics on the
+//! target never returns (the host sees the trap).
+
+use std::hash::{BuildHasher, Hasher};
+
+/// The probe names [`run_probe`] knows.
+pub const PROBES: &[&str] = &[
+    "instant",
+    "systemtime",
+    "sleep",
+    "thread_builder",
+    "thread_spawn",
+    "fs_read",
+    "fs_write",
+    "fs_canonicalize",
+    "net_tcp",
+    "net_udp",
+    "mutex",
+    "atomics",
+    "hashmap_keys",
+    "env",
+    "catch_unwind",
+    "stack_layout",
+    "sizes",
+    "nan_bits",
+    "glam_ops",
+];
+
+/// Runs probe `name`.
+#[must_use]
+pub fn run_probe(name: &str) -> String {
+    match name {
+        "instant" => {
+            let t = std::time::Instant::now();
+            format!("Instant::now() returned; elapsed {:?}", t.elapsed())
+        }
+        "systemtime" => format!("SystemTime::now() = {:?}", std::time::SystemTime::now()),
+        "sleep" => {
+            std::thread::sleep(std::time::Duration::from_millis(1));
+            "thread::sleep(1 ms) returned".into()
+        }
+        "thread_builder" => match std::thread::Builder::new().spawn(|| 7) {
+            Ok(h) => format!("Builder::spawn ok, join = {:?}", h.join()),
+            Err(e) => format!("Builder::spawn Err: kind {:?}: {e}", e.kind()),
+        },
+        "thread_spawn" => {
+            let h = std::thread::spawn(|| 7);
+            format!("thread::spawn ok, join = {:?}", h.join())
+        }
+        "fs_read" => format!(
+            "fs::read(\"/etc/hostname\") = {:?}",
+            std::fs::read("/etc/hostname").map(|b| b.len())
+        ),
+        "fs_write" => format!(
+            "fs::write(\"s1_probe.tmp\") = {:?}",
+            std::fs::write("s1_probe.tmp", b"x")
+        ),
+        "fs_canonicalize" => format!("fs::canonicalize(\".\") = {:?}", std::fs::canonicalize(".")),
+        "net_tcp" => format!(
+            "TcpStream::connect(127.0.0.1:9) = {:?}",
+            std::net::TcpStream::connect("127.0.0.1:9").map(|_| ())
+        ),
+        "net_udp" => format!(
+            "UdpSocket::bind(127.0.0.1:0) = {:?}",
+            std::net::UdpSocket::bind("127.0.0.1:0").map(|_| ())
+        ),
+        "mutex" => {
+            let m = std::sync::Arc::new(std::sync::Mutex::new(5u32));
+            let rw = std::sync::RwLock::new(1u32);
+            let a = {
+                let mut g = m.lock().unwrap();
+                *g += 1;
+                *g
+            };
+            let b = *rw.read().unwrap() + *rw.read().unwrap();
+            let once = std::sync::OnceLock::new();
+            let c = *once.get_or_init(|| 3u32);
+            format!(
+                "Mutex lock ok ({a}), RwLock two readers ok ({b}), OnceLock ok ({c}), try_lock while held = {:?}",
+                {
