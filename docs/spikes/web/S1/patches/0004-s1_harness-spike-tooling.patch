+//! wasm-bindgen exports (wasm32-unknown-unknown).
+
+use crate::run::{self, Every};
+use wasm_bindgen::prelude::*;
+
+#[wasm_bindgen]
+extern "C" {
+    #[wasm_bindgen(js_namespace = performance, js_name = now)]
+    fn perf_now() -> f64;
+}
+
+/// Plays a scenario; returns the hash lines (bytes). Throws on error.
+#[wasm_bindgen]
+pub fn play(bundle: &[u8], scn: &[u8], scr: &[u8]) -> Result<Vec<u8>, JsValue> {
+    run::play(bundle, scn, scr.to_vec(), Every::ALL)
+        .map(|o| {
+            let mut v = o.summary().into_bytes();
+            v.push(b'\n');
+            v.extend_from_slice(&o.hashes);
+            v
+        })
+        .map_err(|e| JsValue::from_str(&e))
+}
+
+/// Times a scenario with `performance.now()`; returns JSON.
+#[wasm_bindgen]
+pub fn bench(
+    bundle: &[u8],
+    scn: &[u8],
+    scr: &[u8],
+    batch: u32,
+    warmup: u32,
+) -> Result<String, JsValue> {
+    let mut clock = || perf_now() * 1e6;
+    run::bench(
+        bundle,
+        scn,
+        scr,
+        &mut clock,
+        u64::from(batch),
+        u64::from(warmup),
+    )
+    .map_err(|e| JsValue::from_str(&e))
+}
+
+/// Allocation-guard check; returns a line.
+#[wasm_bindgen]
+pub fn alloc_check(bundle: &[u8], scn: &[u8], scr: &[u8]) -> Result<String, JsValue> {
+    run::alloc_check(bundle, scn, scr.to_vec())
+        .map(|(installed, ticks, allocs, exempt, first)| {
+            format!(
+                "alloc_guard installed={installed} ticks={ticks} allocs_in_step={allocs} exempt={exempt} first_alloc_tick={first:?}"
+            )
+        })
+        .map_err(|e| JsValue::from_str(&e))
+}
+
+/// Exact-bits state at a tick.
+#[wasm_bindgen]
+pub fn dump(bundle: &[u8], scn: &[u8], scr: &[u8], tick: u32) -> Result<String, JsValue> {
+    run::dump(bundle, scn, scr.to_vec(), u64::from(tick)).map_err(|e| JsValue::from_str(&e))
+}
+
+/// One platform probe (A6/A7/A28).
+#[wasm_bindgen]
+pub fn probe(name: &str) -> String {
+    crate::probes::run_probe(name)
+}
+
+/// Deep recursion, 1 KiB of shadow stack per frame.
+#[wasm_bindgen]
+pub fn recurse_big(n: u32) -> f64 {
+    crate::probes::recurse_big(n) as f64
+}
+
+/// Deep recursion with tiny frames (engine stack).
+#[wasm_bindgen]
+pub fn recurse_small(n: u32) -> f64 {
+    crate::probes::recurse_small(n) as f64
+}
+
+/// Stack high-water mark of a full playback run.
+#[wasm_bindgen]
+pub fn highwater(bundle: &[u8], scn: &[u8], scr: &[u8]) -> Result<String, JsValue> {
+    let layout = crate::probes::stack_layout();
+    let (r, used, painted) = crate::probes::stack_highwater(900 * 1024, || {
+        run::play(
+            bundle,
+            scn,
+            scr.to_vec(),
+            Every {
+                dense: 0,
+                every: u64::MAX,
+            },
+        )
+    });
+    let r = r.map_err(|e| JsValue::from_str(&e))?;
+    Ok(format!(
+        "{layout}\n{} stack_used_below_caller={used} painted={painted}",
+        r.summary()
+    ))
+}
+
+/// Stack high-water marks of load and ticks.
+#[wasm_bindgen]
+pub fn stack_phases(bundle: &[u8], scn: &[u8], scr: &[u8]) -> Result<String, JsValue> {
+    run::stack_phases(bundle, scn, scr.to_vec()).map_err(|e| JsValue::from_str(&e))
+}
+
+/// A7: a panic inside `step_1ms` under `catch_unwind`.
+#[wasm_bindgen]
+pub fn panic_in_step(bundle: &[u8]) -> String {
+    run::panic_in_step(bundle)
+}
+
+/// Installs a panic hook that forwards the message to `console.error`
+/// (the recommended web host reporting path).
+#[wasm_bindgen]
+pub fn install_panic_hook() {
+    std::panic::set_hook(Box::new(|info| {
+        console_error(&format!("s1 panic: {info}"));
+    }));
+}
+
+#[wasm_bindgen]
+extern "C" {
+    #[wasm_bindgen(js_namespace = console, js_name = error)]
+    fn console_error(s: &str);
+}
