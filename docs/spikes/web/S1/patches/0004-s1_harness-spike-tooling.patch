+//! web-spike-sim (S1) harness. Spike tooling, not a product crate.
+//!
+//! * [`io`]: the scenario file (recorded bot operations, input events and
+//!   ball spawns per tick) and the script-output stream (per script step:
+//!   RNG draws, a digest of what the script saw, the command queue).
+//! * [`playback`]: an [`pin_sim::ExternalScript`] that replays a recorded
+//!   script-output stream, so the sim runs on targets without Lua/wasmtime.
+//! * `record` (feature `native`): wraps the real Lua backend and records
+//!   that stream.
+//! * [`driver`]: steps a [`Simulation`] through a scenario.
+//! * [`run`]: play / bench / alloc-check / dump, shared by the native and
+//!   wasip1 binary and the wasm-bindgen exports.
+//! * [`probes`]: platform probes (A6, A7, A28).
+
+pub mod driver;
+pub mod hashes;
+pub mod io;
+pub mod playback;
+pub mod probes;
+#[cfg(feature = "native")]
+pub mod record;
+pub mod run;
+#[cfg(all(target_arch = "wasm32", target_os = "unknown"))]
+pub mod web;
+
+/// The counting allocator of pin_sim's allocation guard (D5 check on every
+/// target; it only counts inside a guard).
+#[global_allocator]
+static GLOBAL: pin_sim::alloc_guard::CountingAlloc = pin_sim::alloc_guard::CountingAlloc;
+
+pub use pin_sim::Simulation;
