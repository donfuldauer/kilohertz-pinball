+//! Play, bench, alloc-check and dump: shared by the native/wasip1 binary
+//! and the wasm-bindgen exports.
+
+use crate::driver::Driver;
+use crate::hashes::ext_hash;
+use crate::io::Scenario;
+use crate::playback::{PlaybackScript, PlaybackStatus};
+use pin_assets::{Vfs, ZipLimits};
+use pin_sim::{ExternalScript, SimConfig, Simulation};
+use std::fmt::Write as _;
+use std::sync::Arc;
+
+/// Opens a zipped bundle from memory (the web path: no file system).
+///
+/// # Errors
+/// The asset error text.
+pub fn open_bundle(bundle_zip: &[u8]) -> Result<Vfs, String> {
+    Vfs::from_zip_bytes(bundle_zip.to_vec(), ZipLimits::default()).map_err(|e| e.to_string())
+}
+
+/// Loads `bundle_zip` with the scenario's seed and a playback backend over
+/// `scr`; checks the table hash.
+///
+/// # Errors
+/// Load failures and a table-hash mismatch.
+pub fn load_playback(
+    bundle_zip: &[u8],
+    scn: &Scenario,
+    scr: Vec<u8>,
+) -> Result<(Simulation, Arc<PlaybackStatus>), String> {
+    let vfs = open_bundle(bundle_zip)?;
+    let (script, status) = PlaybackScript::new(scr)?;
+    let mut slot = Some(script);
+    let sim = Simulation::load_from_vfs_with_script(
+        &vfs,
+        SimConfig {
+            seed: scn.seed,
+            ..SimConfig::default()
+        },
+        &mut |_entry, _src, _names| {
+            let s = slot.take().expect("factory called once");
+            Ok(Box::new(s) as Box<dyn ExternalScript>)
+        },
+    )
+    .map_err(|e| e.to_string())?;
+    if sim.table_hash() != scn.table_hash {
+        return Err(format!(
+            "table hash {:016x} is not the scenario's {:016x}",
+            sim.table_hash(),
+            scn.table_hash
+        ));
+    }
+    Ok((sim, status))
+}
+
+/// Which ticks get a hash line: every tick up to `dense`, then every
+/// `every`-th, and the last.
+#[derive(Copy, Clone, Debug)]
+pub struct Every {
+    /// Ticks always written from the start.
+    pub dense: u64,
+    /// Stride after that.
+    pub every: u64,
+}
+
+impl Every {
+    /// Every tick.
+    pub const ALL: Every = Every {
+        dense: u64::MAX,
+        every: 1,
+    };
+
+    /// Whether tick `tick` of a run of `last` ticks gets a line.
+    #[must_use]
+    pub fn wants(self, tick: u64, last: u64) -> bool {
+        tick <= self.dense || tick.is_multiple_of(self.every.max(1)) || tick == last
+    }
+}
+
+/// The result of [`play`].
+#[derive(Clone, Debug)]
+pub struct PlayOut {
+    /// `tick state_hash ext_hash` lines (hex), tick 0 = after load.
+    pub hashes: Vec<u8>,
+    /// Final state hash.
+    pub final_state: u64,
+    /// Final supplementary hash.
+    pub final_ext: u64,
+    /// Ticks run.
+    pub ticks: u64,
+    /// First tick whose script-input digest differed from the recording.
+    pub first_mismatch: Option<u64>,
+    /// Script steps that ran past the recording.
+    pub exhausted: u64,
+    /// Most balls in play at once.
+    pub max_balls: usize,
+    /// Score of player 0 at the end.
+    pub score: Option<i64>,
+}
+
+impl PlayOut {
+    /// One summary line.
+    #[must_use]
+    pub fn summary(&self) -> String {
+        format!(
+            "ticks={} state_hash={:016x} ext_hash={:016x} script_digest_mismatch={} exhausted={} max_balls={} score={}",
+            self.ticks,
+            self.final_state,
+            self.final_ext,
+            self.first_mismatch
+                .map_or_else(|| "none".to_owned(), |t| t.to_string()),
+            self.exhausted,
+            self.max_balls,
+            self.score
+                .map_or_else(|| "none".to_owned(), |s| s.to_string())
+        )
+    }
+}
+
+fn hash_line(out: &mut dyn FnMut(&[u8]), sim: &Simulation) {
+    let mut s = String::with_capacity(40);
+    let _ = writeln!(
+        s,
+        "{} {:016x} {:016x}",
+        sim.tick(),
+        sim.state_hash(),
+        ext_hash(sim)
+    );
+    out(s.as_bytes());
+}
+
+/// Plays the scenario with the playback backend, collecting hash lines.
+///
+/// # Errors
+/// Load and scenario failures.
+pub fn play(
+    bundle_zip: &[u8],
+    scn_bytes: &[u8],
+    scr: Vec<u8>,
+    every: Every,
+) -> Result<PlayOut, String> {
+    let mut hashes = Vec::with_capacity(64 * 1024);
+    let mut out = play_to(bundle_zip, scn_bytes, scr, every, &mut |b| {
+        hashes.extend_from_slice(b)
+    })?;
+    out.hashes = hashes;
+    Ok(out)
+}
+
+/// [`play`] streaming the hash lines to `sink` (its `hashes` is empty).
+///
+/// # Errors
+/// Load and scenario failures.
+pub fn play_to(
+    bundle_zip: &[u8],
+    scn_bytes: &[u8],
+    scr: Vec<u8>,
+    every: Every,
+    sink: &mut dyn FnMut(&[u8]),
+) -> Result<PlayOut, String> {
+    let scn = Scenario::from_bytes(scn_bytes)?;
+    let (mut sim, status) = load_playback(bundle_zip, &scn, scr)?;
+    let mut drv = Driver::new(&scn);
+    hash_line(sink, &sim);
+    let mut max_balls = 0;
+    while sim.tick() < scn.ticks {
+        let t = drv.advance(&mut sim)?;
+        max_balls = max_balls.max(sim.balls_in_play());
+        if every.wants(t, scn.ticks) {
+            hash_line(sink, &sim);
+        }
+    }
+    Ok(PlayOut {
+        hashes: Vec::new(),
+        final_state: sim.state_hash(),
+        final_ext: ext_hash(&sim),
+        ticks: sim.tick(),
+        first_mismatch: status.first_mismatch(),
+        exhausted: status.exhausted.load(std::sync::atomic::Ordering::Relaxed),
+        max_balls,
+        score: sim.score(0),
+    })
+}
+
+/// Summary statistics of samples (ns).
+#[derive(Clone, Debug, Default)]
+pub struct Stats {
+    /// Samples.
+    pub n: usize,
+    /// Mean.
+    pub mean: f64,
+    /// Median.
+    pub p50: f64,
+    /// 99th percentile.
+    pub p99: f64,
+    /// 99.9th percentile.
+    pub p999: f64,
+    /// Maximum.
+    pub max: f64,
+}
+
+impl Stats {
+    /// Statistics of `v` (sorted in place).
+    pub fn of(v: &mut [f64]) -> Stats {
+        if v.is_empty() {
+            return Stats::default();
+        }
+        v.sort_by(f64::total_cmp);
+        let q = |p: f64| v[((v.len() - 1) as f64 * p).round() as usize];
+        Stats {
+            n: v.len(),
+            mean: v.iter().sum::<f64>() / v.len() as f64,
+            p50: q(0.5),
+            p99: q(0.99),
+            p999: q(0.999),
+            max: v[v.len() - 1],
+        }
+    }
+
+    fn json(&self) -> String {
+        format!(
+            "{{\"n\":{},\"mean_us\":{:.3},\"p50_us\":{:.3},\"p99_us\":{:.3},\"p999_us\":{:.3},\"max_us\":{:.3}}}",
+            self.n,
+            self.mean / 1e3,
+            self.p50 / 1e3,
+            self.p99 / 1e3,
+            self.p999 / 1e3,
+            self.max / 1e3
+        )
+    }
+}
+
+/// Ball-count buckets of the per-tick statistics.
+pub const BALL_BUCKETS: [(usize, usize); 6] = [(0, 0), (1, 1), (2, 2), (3, 4), (5, 8), (9, 16)];
+
+/// Times the scenario (playback backend, no hashing): pass 1 times every
+/// tick; pass 2 (a fresh load) times batches of `batch` ticks (one 60 Hz
+/// frame of catch-up = 16 or 17 ticks) and the whole run. `now_ns` is the
+/// platform clock. Returns JSON.
+///
+/// # Errors
+/// Load and scenario failures.
+pub fn bench(
+    bundle_zip: &[u8],
+    scn_bytes: &[u8],
+    scr: &[u8],
+    now_ns: &mut dyn FnMut() -> f64,
+    batch: u64,
+    warmup: u64,
+) -> Result<String, String> {
+    let scn = Scenario::from_bytes(scn_bytes)?;
+    // Pass 1: per tick.
+    let (mut sim, _) = load_playback(bundle_zip, &scn, scr.to_vec())?;
+    let mut drv = Driver::new(&scn);
+    let n = scn.ticks as usize;
+    let mut per_tick = Vec::with_capacity(n);
+    let mut balls = Vec::with_capacity(n);
+    while sim.tick() < scn.ticks {
+        let t = drv.prepare(&mut sim)?;
+        let t0 = now_ns();
+        drv.step(&mut sim, t);
+        let t1 = now_ns();
+        per_tick.push(t1 - t0);
+        balls.push(sim.balls_in_play() as u8);
+    }
+    let w = (warmup as usize).min(per_tick.len());
+    let mut all = per_tick.clone();
+    let mut steady = per_tick[w..].to_vec();
+    let mut buckets = String::new();
+    for (lo, hi) in BALL_BUCKETS {
+        let mut v: Vec<f64> = per_tick[w..]
+            .iter()
+            .zip(&balls[w..])
+            .filter(|(_, b)| (lo..=hi).contains(&usize::from(**b)))
+            .map(|(t, _)| *t)
+            .collect();
+        if !v.is_empty() {
+            let _ = write!(
+                buckets,
+                "{}\"{}-{}\":{}",
+                if buckets.is_empty() { "" } else { "," },
+                lo,
+                hi,
+                Stats::of(&mut v).json()
+            );
+        }
+    }
+    let ball_mean = balls.iter().map(|&b| f64::from(b)).sum::<f64>() / balls.len().max(1) as f64;
+    let ball_max = balls.iter().copied().max().unwrap_or(0);
+    // Pass 2: batches and the whole run, one clock read per batch.
+    let (mut sim, _) = load_playback(bundle_zip, &scn, scr.to_vec())?;
+    let mut drv = Driver::new(&scn);
+    let mut batches = Vec::with_capacity(n / batch.max(1) as usize + 1);
+    let start = now_ns();
+    let mut b0 = start;
+    let mut in_batch = 0;
+    while sim.tick() < scn.ticks {
+        drv.advance(&mut sim)?;
+        in_batch += 1;
+        if in_batch == batch {
+            let b1 = now_ns();
+            if sim.tick() > warmup {
+                batches.push(b1 - b0);
+            }
+            b0 = b1;
+            in_batch = 0;
+        }
+    }
+    let total = now_ns() - start;
+    Ok(format!(
+        "{{\"ticks\":{},\"warmup\":{},\"total_ms\":{:.3},\"mean_tick_us_total\":{:.3},\"per_tick_all\":{},\"per_tick_steady\":{},\"batch_ticks\":{},\"batch_steady\":{},\"balls_mean\":{:.3},\"balls_max\":{},\"per_ball_bucket_steady\":{{{}}}}}",
+        scn.ticks,
+        warmup,
+        total / 1e6,
+        total / 1e3 / scn.ticks as f64,
+        Stats::of(&mut all).json(),
+        Stats::of(&mut steady).json(),
+        batch,
+        Stats::of(&mut batches).json(),
+        ball_mean,
+        ball_max,
+        buckets
+    ))
+}
+
+/// Runs the scenario with every `step_1ms` inside the allocation guard;
+/// returns `(installed, ticks, allocs, exempt allocs, first allocating
+/// tick)`.
+///
+/// # Errors
+/// Load and scenario failures.
+pub fn alloc_check(
+    bundle_zip: &[u8],
+    scn_bytes: &[u8],
+    scr: Vec<u8>,
+) -> Result<(bool, u64, u64, u64, Option<u64>), String> {
+    let scn = Scenario::from_bytes(scn_bytes)?;
+    let (mut sim, _) = load_playback(bundle_zip, &scn, scr)?;
+    let mut drv = Driver::new(&scn);
+    let (mut allocs, mut exempt, mut first) = (0u64, 0u64, None);
+    while sim.tick() < scn.ticks {
+        let t = drv.prepare(&mut sim)?;
+        let ((), a, e) = pin_sim::alloc_guard::count_allocs_split(|| drv.step(&mut sim, t));
+        if a > 0 && first.is_none() {
+            first = Some(t);
+        }
+        allocs += a;
+        exempt += e;
+    }
+    Ok((
+        pin_sim::alloc_guard::is_installed(),
+        sim.tick(),
+        allocs,
+        exempt,
+        first,
+    ))
+}
+
+/// The full state at tick `at` with exact float bits (divergence
+/// diagnosis).
+///
+/// # Errors
+/// Load and scenario failures.
+pub fn dump(bundle_zip: &[u8], scn_bytes: &[u8], scr: Vec<u8>, at: u64) -> Result<String, String> {
+    let scn = Scenario::from_bytes(scn_bytes)?;
+    let (mut sim, _) = load_playback(bundle_zip, &scn, scr)?;
+    let mut drv = Driver::new(&scn);
+    while sim.tick() < at.min(scn.ticks) {
+        drv.advance(&mut sim)?;
+    }
+    Ok(describe(&sim))
+}
+
+/// Exact-bits description of the hashed and published state.
+#[must_use]
+pub fn describe(sim: &Simulation) -> String {
+    let mut o = String::new();
+    let _ = writeln!(
+        o,
+        "tick {} state_hash {:016x} ext_hash {:016x}",
+        sim.tick(),
+        sim.state_hash(),
+        ext_hash(sim)
+    );
+    let s = sim.snapshot();
+    for (i, b) in s.balls().iter().enumerate() {
+        let bits = |v: &[f32]| {
+            v.iter()
+                .map(|x| format!("{x:e}({:08x})", x.to_bits()))
+                .collect::<Vec<_>>()
+                .join(" ")
+        };
+        let _ = writeln!(o, "ball {i} layer {} profile {}", b.layer, b.profile.0);
+        let _ = writeln!(o, "  pos {}", bits(&b.position_m));
+        let _ = writeln!(o, "  vel {}", bits(&b.velocity_m_s));
+        let _ = writeln!(o, "  ang {}", bits(&b.angular_velocity_rad_s));
+        let _ = writeln!(o, "  rot {}", bits(&b.orientation));
+    }
+    for f in s.flippers() {
+        let _ = writeln!(
+            o,
+            "flipper {} angle {:e}({:08x}) w {:e}({:08x}) zip {:08x}",
+            f.id.0,
+            f.angle_rad,
+            f.angle_rad.to_bits(),
+            f.angular_velocity_rad_s,
+            f.angular_velocity_rad_s.to_bits(),
+            f.zipper_offset_m.to_bits()
+        );
+    }
+    for (i, m) in s.dynamic_meshes().iter().enumerate() {
+        let _ = writeln!(
+            o,
+            "mesh {i} pos {:08x} {:08x} {:08x} rot {:08x} {:08x} {:08x} {:08x}",
+            m.position_m[0].to_bits(),
+            m.position_m[1].to_bits(),
+            m.position_m[2].to_bits(),
+            m.orientation[0].to_bits(),
+            m.orientation[1].to_bits(),
+            m.orientation[2].to_bits(),
+            m.orientation[3].to_bits()
+        );
+    }
+    let _ = writeln!(o, "switches {:016x?}", sim.switch_bits());
+    let _ = writeln!(o, "counters {:?}", sim.counters());
+    o
+}
+
+/// A7 probe: loads `bundle_zip` with a backend that panics inside
+/// `step_1ms` at tick 5 and steps under `catch_unwind`. Natively the panic
+/// is caught and the message says so; under `panic=abort` (wasm32) the
+/// call traps and never returns.
+#[must_use]
+pub fn panic_in_step(bundle_zip: &[u8]) -> String {
+    let vfs = match open_bundle(bundle_zip) {
+        Ok(v) => v,
+        Err(e) => return e,
+    };
+    let sim =
+        Simulation::load_from_vfs_with_script(&vfs, SimConfig::default(), &mut |_e, _s, _n| {
+            Ok(Box::new(crate::playback::PanicScript { at: 5 }) as Box<dyn ExternalScript>)
+        });
+    let mut sim = match sim {
+        Ok(s) => s,
+        Err(e) => return e.to_string(),
+    };
+    let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        sim.advance(10);
+    }));
+    format!(
+        "catch_unwind around step_1ms returned {} (sim tick {})",
+        if r.is_err() {
+            "Err: panic caught, process alive"
+        } else {
+            "Ok"
+        },
+        sim.tick()
+    )
+}
+
+/// Stack high-water marks (bytes below the caller's frame) of loading the
+/// table and of running every tick of the scenario, measured separately by
+/// painting the unused shadow stack (wasm32 only).
+///
+/// # Errors
+/// Load and scenario failures.
+#[cfg(target_arch = "wasm32")]
+pub fn stack_phases(bundle_zip: &[u8], scn_bytes: &[u8], scr: Vec<u8>) -> Result<String, String> {
+    let scn = Scenario::from_bytes(scn_bytes)?;
+    let (loaded, load_used, painted) =
+        crate::probes::stack_highwater(900 * 1024, || load_playback(bundle_zip, &scn, scr));
+    let (mut sim, _) = loaded?;
+    let mut drv = Driver::new(&scn);
+    let (r, tick_used, _) = crate::probes::stack_highwater(900 * 1024, || {
+        while sim.tick() < scn.ticks {
+            drv.advance(&mut sim)?;
+        }
+        Ok::<(), String>(())
+    });
+    r?;
+    Ok(format!(
+        "{} load_stack_bytes={load_used} ticks={} tick_stack_bytes={tick_used} painted={painted} state_hash={:016x}",
+        crate::probes::stack_layout(),
+        sim.tick(),
+        sim.state_hash()
+    ))
+}
