+//! `s1`: the S1 harness command line (native and wasm32-wasip1).
+//!
+//! ```text
+//! s1 record-bot <bundle_dir> <bundle_zip> <seed> <ticks> <out_prefix>   (feature native)
+//! s1 record-pattern <bundle_zip> <seed> <ticks> <spawns> <out_prefix> [nolaunch]  (feature native)
+//! s1 builtin <bundle_dir> <scn> <out_hashes>                           (feature native)
+//! s1 bench-lua <bundle_dir> <scn>                                      (feature native)
+//! s1 play <bundle_zip> <scn> <scr> <out_hashes>
+//! s1 bench <bundle_zip> <scn> <scr> [batch=16] [warmup=5000]
+//! s1 alloc <bundle_zip> <scn> <scr>
+//! s1 dump <bundle_zip> <scn> <scr> <tick>
+//! s1 probe <name>|all
+//! s1 recurse-big <n> | recurse-small <n>
+//! s1 highwater <bundle_zip> <scn> <scr>                                (wasm32)
+//! s1 panic-in-step <bundle_zip>
+//! s1 bigwrite <file> <MiB>
+//! ```
+
+use s1_harness::run::{self, Every};
+use std::time::Instant;
+
+fn read(p: &str) -> Vec<u8> {
+    std::fs::read(p).unwrap_or_else(|e| fail(&format!("read {p}: {e}")))
+}
+
+/// Writes in 1 MiB chunks: Node 22's `node:wasi` segfaults on one very
+/// large `fd_write` (see `bigwrite`).
+#[cfg_attr(not(feature = "native"), allow(dead_code))]
+fn write(p: &str, b: &[u8]) {
+    use std::io::Write as _;
+    let mut f = std::fs::File::create(p).unwrap_or_else(|e| fail(&format!("create {p}: {e}")));
+    for c in b.chunks(1 << 20) {
+        f.write_all(c)
+            .unwrap_or_else(|e| fail(&format!("write {p}: {e}")));
+    }
+}
+
+fn fail(m: &str) -> ! {
+    eprintln!("s1: {m}");
+    std::process::exit(1)
+}
+
+fn num(s: &str) -> u64 {
+    match s.strip_prefix("0x") {
+        Some(h) => u64::from_str_radix(h, 16),
+        None => s.parse(),
+    }
+    .unwrap_or_else(|_| fail(&format!("not a number: {s}")))
+}
+
+#[cfg(feature = "native")]
+fn record(a: &[String]) -> bool {
+    use s1_harness::record;
+    match a.first().map(String::as_str) {
+        Some("record-bot") if a.len() == 6 => {
+            let zip = read(&a[2]);
+            let r = record::record_bot(
+                std::path::Path::new(&a[1]),
+                &zip,
+                num(&a[3]),
+                num(&a[4]),
+                pin_sim::autoplay::SkillLevel::Standard,
+                Every::ALL,
+            )
+            .unwrap_or_else(|e| fail(&e));
+            let p = &a[5];
+            write(&format!("{p}.scn"), &r.scenario.to_bytes());
+            write(&format!("{p}.scr"), &r.script);
+            write(&format!("{p}.native_lua.hashes"), &r.hashes);
+            if let Some(g) = &r.game {
+                write(&format!("{p}.khzrec"), &g.to_bytes());
+            }
+            println!("{}", r.summary);
+            true
+        }
+        Some("record-pattern") if a.len() == 6 || a.len() == 7 => {
+            let zip = read(&a[1]);
+            let launch = a.get(6).map(String::as_str) != Some("nolaunch");
+            let r = record::record_pattern(
+                &zip,
+                num(&a[2]),
+                num(&a[3]),
+                num(&a[4]) as usize,
+                launch,
+                Every::ALL,
+            )
+            .unwrap_or_else(|e| fail(&e));
+            let p = &a[5];
+            write(&format!("{p}.scn"), &r.scenario.to_bytes());
+            write(&format!("{p}.scr"), &r.script);
+            write(&format!("{p}.native_lua.hashes"), &r.hashes);
+            println!("{}", r.summary);
+            true
+        }
+        Some("bench-lua") if a.len() == 3 => {
+            let scn =
+                s1_harness::io::Scenario::from_bytes(&read(&a[2])).unwrap_or_else(|e| fail(&e));
+            let j = record::bench_builtin(std::path::Path::new(&a[1]), &scn, 5000)
+                .unwrap_or_else(|e| fail(&e));
+            println!("{j}");
+            true
+        }
+        Some("builtin") if a.len() == 4 => {
+            let scn =
+                s1_harness::io::Scenario::from_bytes(&read(&a[2])).unwrap_or_else(|e| fail(&e));
+            let h = record::run_builtin(std::path::Path::new(&a[1]), &scn, Every::ALL)
+                .unwrap_or_else(|e| fail(&e));
+            write(&a[3], &h);
+            println!(
+                "builtin ticks={} lines={}",
+                scn.ticks,
+                h.iter().filter(|&&b| b == b'\n').count()
+            );
+            true
+        }
+        _ => false,
+    }
+}
+
+#[cfg(not(feature = "native"))]
+fn record(_a: &[String]) -> bool {
+    false
+}
+
+fn main() {
+    let a: Vec<String> = std::env::args().skip(1).collect();
+    if record(&a) {
+        return;
+    }
+    match a.first().map(String::as_str) {
+        Some("play") if a.len() == 5 => {
+            // Streams the lines through a 64 KiB buffer: keeps the guest's
+            // memory small (Node 22's node:wasi segfaults on any fd_write
+            // once linear memory passes ~32 MiB; see `bigmem`).
+            use std::io::Write as _;
+            let t0 = Instant::now();
+            let f = std::fs::File::create(&a[4]).unwrap_or_else(|e| fail(&format!("create: {e}")));
+            let mut w = std::io::BufWriter::with_capacity(64 * 1024, f);
+            let mut err = None;
+            let out = run::play_to(
+                &read(&a[1]),
+                &read(&a[2]),
+                read(&a[3]),
+                Every::ALL,
+                &mut |b| {
+                    if let Err(e) = w.write_all(b) {
+                        err.get_or_insert(e);
+                    }
+                },
+            )
+            .unwrap_or_else(|e| fail(&e));
+            if let Some(e) = err.or_else(|| w.flush().err()) {
+                fail(&format!("write {}: {e}", a[4]));
+            }
+            println!("{} wall_ms={}", out.summary(), t0.elapsed().as_millis());
+        }
+        Some("bench") if a.len() >= 4 => {
+            let batch = a.get(4).map_or(16, |s| num(s));
+            let warm = a.get(5).map_or(5000, |s| num(s));
+            let epoch = Instant::now();
+            let mut clock = || epoch.elapsed().as_nanos() as f64;
+            let j = run::bench(
+                &read(&a[1]),
+                &read(&a[2]),
+                &read(&a[3]),
+                &mut clock,
+                batch,
+                warm,
+            )
+            .unwrap_or_else(|e| fail(&e));
+            println!("{j}");
+        }
+        Some("alloc") if a.len() == 4 => {
+            let (installed, ticks, allocs, exempt, first) =
+                run::alloc_check(&read(&a[1]), &read(&a[2]), read(&a[3]))
+                    .unwrap_or_else(|e| fail(&e));
+            println!(
+                "alloc_guard installed={installed} ticks={ticks} allocs_in_step={allocs} exempt={exempt} first_alloc_tick={first:?}"
+            );
+        }
+        Some("dump") if a.len() == 5 => {
+            let d = run::dump(&read(&a[1]), &read(&a[2]), read(&a[3]), num(&a[4]))
+                .unwrap_or_else(|e| fail(&e));
+            print!("{d}");
+        }
+        Some("probe") if a.len() == 2 => {
+            if a[1] == "all" {
+                for p in s1_harness::probes::PROBES {
+                    println!("{p}: {}", s1_harness::probes::run_probe(p));
+                }
+            } else {
+                println!("{}: {}", a[1], s1_harness::probes::run_probe(&a[1]));
+            }
+        }
+        Some("recurse-big") if a.len() == 2 => {
+            let n = num(&a[1]) as u32;
+            println!("recurse_big({n}) = {}", s1_harness::probes::recurse_big(n));
+        }
+        Some("recurse-small") if a.len() == 2 => {
+            let n = num(&a[1]) as u32;
+            println!(
+                "recurse_small({n}) = {}",
+                s1_harness::probes::recurse_small(n)
+            );
+        }
+        #[cfg(target_arch = "wasm32")]
+        Some("highwater") if a.len() == 4 => {
+            let (bundle, scn, scr) = (read(&a[1]), read(&a[2]), read(&a[3]));
+            println!("{}", s1_harness::probes::stack_layout());
+            let (r, used, painted) = s1_harness::probes::stack_highwater(900 * 1024, || {
+                run::play(
+                    &bundle,
+                    &scn,
+                    scr,
+                    Every {
+                        dense: 0,
+                        every: u64::MAX,
+                    },
+                )
+            });
+            let r = r.unwrap_or_else(|e| fail(&e));
+            println!(
+                "{} stack_used_below_caller={used} painted={painted}",
+                r.summary()
+            );
+        }
+        Some("bigwrite") if a.len() == 3 => {
+            // One `std::fs::write` (a single large fd_write) of N MiB.
+            let n = num(&a[2]) as usize;
+            std::fs::write(&a[1], vec![b'x'; n << 20])
+                .unwrap_or_else(|e| fail(&format!("write: {e}")));
+            println!("bigwrite {n} MiB ok");
+        }
+        Some("bigmem") if a.len() == 4 => {
+            // Holds N MiB of heap, then writes K KiB with one fd_write.
+            let n = num(&a[2]) as usize;
+            let k = num(&a[3]) as usize;
+            let hold = std::hint::black_box(vec![1u8; n << 20]);
+            std::fs::write(&a[1], &hold[..k << 10])
+                .unwrap_or_else(|e| fail(&format!("write: {e}")));
+            println!("bigmem {n} MiB held, {k} KiB written ok");
+        }
+        #[cfg(target_arch = "wasm32")]
+        Some("stack-phases") if a.len() == 4 => {
+            let r = run::stack_phases(&read(&a[1]), &read(&a[2]), read(&a[3]))
+                .unwrap_or_else(|e| fail(&e));
+            println!("{r}");
+        }
+        Some("panic-in-step") if a.len() == 2 => {
+            let msg = s1_harness::run::panic_in_step(&read(&a[1]));
+            println!("{msg}");
+        }
+        _ => fail("bad arguments (see the source header for usage)"),
+    }
+}
