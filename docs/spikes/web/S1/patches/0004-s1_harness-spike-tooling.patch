+//! Replays a recorded script-output stream as a rules backend.
+//!
+//! Per script step it checks that the script would have seen the same
+//! switch edges and `HostView` as in the recording (digest), advances the
+//! sim's `Pcg32` by the recorded number of draws and writes the recorded
+//! command queue. Nothing allocates in the callbacks.
+
+use crate::io::{Reader, check_script_stream, decode_queue, digest_view};
+use pin_core::ids::SwitchId;
+use pin_core::{HostCtx, ScriptError, SwitchEdge, TableScriptBackend};
+use pin_sim::ExternalScript;
+use pin_sim::hash::Fnv64;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+/// Status shared with the driver (atomics: readable after the sim owns the
+/// backend, no allocation on update).
+#[derive(Debug)]
+pub struct PlaybackStatus {
+    /// First tick whose digest differed from the recording (`u64::MAX`:
+    /// none).
+    pub first_mismatch: AtomicU64,
+    /// Steps whose digest differed.
+    pub mismatches: AtomicU64,
+    /// Steps played.
+    pub steps: AtomicU64,
+    /// Steps requested after the stream ended or with a bad record.
+    pub exhausted: AtomicU64,
+}
+
+impl Default for PlaybackStatus {
+    fn default() -> Self {
+        Self {
+            first_mismatch: AtomicU64::new(u64::MAX),
+            mismatches: AtomicU64::new(0),
+            steps: AtomicU64::new(0),
+            exhausted: AtomicU64::new(0),
+        }
+    }
+}
+
+impl PlaybackStatus {
+    /// First mismatching tick, if any.
+    #[must_use]
+    pub fn first_mismatch(&self) -> Option<u64> {
+        let t = self.first_mismatch.load(Ordering::Relaxed);
+        (t != u64::MAX).then_some(t)
+    }
+}
+
+/// The playback backend.
+pub struct PlaybackScript {
+    data: Vec<u8>,
+    pos: usize,
+    end: usize,
+    left: u64,
+    digest: Fnv64,
+    fresh: bool,
+    status: Arc<PlaybackStatus>,
+}
+
+impl PlaybackScript {
+    /// A backend over the stream bytes `data`.
+    ///
+    /// # Errors
+    /// A message for a malformed stream.
+    pub fn new(data: Vec<u8>) -> Result<(Self, Arc<PlaybackStatus>), String> {
+        let (steps, pos, end) = check_script_stream(&data)?;
+        let status = Arc::new(PlaybackStatus::default());
+        Ok((
+            Self {
+                data,
+                pos,
+                end,
+                left: steps,
+                digest: Fnv64::new(),
+                fresh: true,
+                status: Arc::clone(&status),
+            },
+            status,
+        ))
+    }
+
+    fn play_step(&mut self, ctx: &mut HostCtx) {
+        if self.fresh {
+            self.digest = Fnv64::new();
+        }
+        self.fresh = true;
+        digest_view(&mut self.digest, ctx.view);
+        let got = self.digest.finish();
+        if self.left == 0 {
+            self.status.exhausted.fetch_add(1, Ordering::Relaxed);
+            return;
+        }
+        let mut r = Reader::new(&self.data[..self.end], self.pos);
+        let step = (|| {
+            let tick = r.u64()?;
+            let draws = r.u32()?;
+            let digest = r.u64()?;
+            let len = r.u32()? as usize;
+            let qstart = r.pos();
+            if len > 0 {
+                decode_queue(&mut r, ctx.cmd)?;
+                if r.pos() != qstart + len {
+                    return None;
+                }
+            }
+            Some((tick, draws, digest, qstart + len))
+        })();
+        let Some((tick, draws, digest, next)) = step else {
+            self.status.exhausted.fetch_add(1, Ordering::Relaxed);
+            self.left = 0;
+            return;
+        };
+        self.pos = next;
+        self.left -= 1;
+        self.status.steps.fetch_add(1, Ordering::Relaxed);
+        if digest != got || tick != ctx.view.tick {
+            self.status.mismatches.fetch_add(1, Ordering::Relaxed);
+            let _ = self.status.first_mismatch.compare_exchange(
+                u64::MAX,
+                ctx.view.tick,
+                Ordering::Relaxed,
+                Ordering::Relaxed,
+            );
+        }
+        ctx.rng.advance(u64::from(draws));
+    }
+}
+
+impl TableScriptBackend for PlaybackScript {
+    fn on_init(&mut self, ctx: &mut HostCtx) {
+        self.fresh = true;
+        self.play_step(ctx);
+    }
+
+    fn on_tick(&mut self, ctx: &mut HostCtx) {
+        self.play_step(ctx);
+    }
+
+    fn on_switch_edge(&mut self, switch: SwitchId, edge: SwitchEdge, _ctx: &mut HostCtx) {
+        if self.fresh {
+            self.digest = Fnv64::new();
+            self.fresh = false;
+        }
+        self.digest.write_u32(u32::from(switch.0));
+        self.digest.write_u8(u8::from(edge == SwitchEdge::Closed));
+    }
+
+    fn apply_reload(&mut self, _source: &[u8]) -> Result<(), ScriptError> {
+        Err(ScriptError::Load("playback backend cannot reload".into()))
+    }
+}
+
+impl ExternalScript for PlaybackScript {}
+
+/// A backend that panics in `on_tick` of tick `at` (A7 probe: a panic
+/// raised inside `step_1ms`).
+pub struct PanicScript {
+    /// Tick to panic at.
+    pub at: u64,
+}
+
+impl TableScriptBackend for PanicScript {
+    fn on_init(&mut self, _ctx: &mut HostCtx) {}
+    fn on_tick(&mut self, ctx: &mut HostCtx) {
+        assert!(
+            ctx.view.tick != self.at,
+            "s1 probe: deliberate panic inside step_1ms at tick {}",
+            self.at
+        );
+    }
+    fn on_switch_edge(&mut self, _s: SwitchId, _e: SwitchEdge, _ctx: &mut HostCtx) {}
+    fn apply_reload(&mut self, _source: &[u8]) -> Result<(), ScriptError> {
+        Ok(())
+    }
+}
+
+impl ExternalScript for PanicScript {}
